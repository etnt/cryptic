#!/usr/bin/env escript

%%% @doc Escript entry point for the Cryptic Console
%%%
%%% Usage: ./cryptic_console [options]
%%%
%%% Options:
%%%   --username <user>        Username (required)
%%%   --server-host <host>     Server hostname (default: localhost)
%%%   --server-port <port>     Server port (default: 8443)
%%%   --notifier <file-path>   Path to notification script (optional)
%%%   --verbose                Enable verbose output
%%%   --help                   Show this help

main(Args) ->
    %% Set up code paths relative to the script location
    setup_code_paths(),

    %% Ensure crypto application is started
    application:ensure_all_started(crypto),

    %% Parse command line options using eclip
    case eclip:parse(Args, spec(), #{}) of
        {ok, {_Spec, _Env, Opts, _Extra}} when is_map(Opts) ->
            %% Extract options from the parsed result
            Username = maps:get(username, Opts),
            ServerHost = maps:get(server_host, Opts, "localhost"),
            ServerPort = maps:get(server_port, Opts, 8443),
            Notifier = maps:get(notifier, Opts, undefined),
            EnableDb = maps:get(enable_db, Opts, false),

            %% Start Erlang distribution using username as node name
            start_distribution(Username),

            %% Build configuration map
            Config = #{
                username => list_to_binary(Username),
                server_host => ServerHost,
                server_port => ServerPort,
                notifier => Notifier,
                enable_db => EnableDb
            },

            %% Display startup banner
            io:format("=== Cryptic Console ===~n"),

            %% Start the console
            cryptic_console:main(Config);
        {done, _} ->
            %% Help was shown or similar, exit gracefully
            ok;
        {error, Reason} ->
            io:format("Error: ~s~n", [Reason]),
            halt(1);
        Result ->
            io:format("Unexpected result: ~p~n", [Result]),
            halt(1)
    end.

%% @doc Eclip command specification
spec() ->
    #{
        help => "Cryptic Console - Secure messaging console interface",
        opts => [
            #{
                name => username,
                short => $u,
                long => "username",
                required => true,
                help => "Username for the console session"
            },
            #{
                name => server_host,
                short => $s,
                long => "server-host",
                default => "localhost",
                help => "Server hostname to connect to"
            },
            #{
                name => server_port,
                short => $p,
                long => "server-port",
                type => int,
                default => 8443,
                help => "Server port to connect to"
            },
            #{
                name => notifier,
                short => $n,
                long => "notifier",
                help =>
                    "Path to notification script (invoked on message arrival)"
            },
            #{
                name => enable_db,
                long => "enable-db",
                type => flag,
                help =>
                    "Enable encrypted message database storage (default: disabled for privacy)"
            }
        ]
    }.

%% @doc Set up code paths relative to the script location
setup_code_paths() ->
    %% Get the directory where this escript is located
    ScriptPath = escript:script_name(),
    ScriptDir = filename:dirname(ScriptPath),

    %% Calculate the repository root (one level up from scripts/)
    RepoRoot = filename:join(ScriptDir, ".."),

    %% Add the required ebin directories to the code path
    EbinPaths = [
        filename:join([RepoRoot, "_build", "default", "lib", "cryptic", "ebin"]),
        filename:join([RepoRoot, "_build", "default", "lib", "eclip", "ebin"]),
        filename:join([RepoRoot, "_build", "default", "lib", "jsx", "ebin"]),
        filename:join([RepoRoot, "_build", "default", "lib", "gun", "ebin"]),
        filename:join([RepoRoot, "_build", "default", "lib", "cowboy", "ebin"]),
        filename:join([RepoRoot, "_build", "default", "lib", "ranch", "ebin"]),
        filename:join([RepoRoot, "_build", "default", "lib", "cowlib", "ebin"]),
        filename:join([RepoRoot, "_build", "default", "lib", "uuid", "ebin"]),
        filename:join([RepoRoot, "_build", "default", "lib", "cecho", "ebin"]),
        filename:join([RepoRoot, "_build", "default", "lib", "esqlite", "ebin"])
    ],

    %% Add each path if it exists
    lists:foreach(
        fun(Path) ->
            case filelib:is_dir(Path) of
                true ->
                    code:add_path(Path);
                false ->
                    io:format("Warning: ebin path not found: ~s~n", [Path])
            end
        end,
        EbinPaths
    ).

%% @doc Start Erlang distribution using username as node name
%% @param Username The username (will be used as node name)
start_distribution(Username) ->
    %% Create node name as username@localhost
    NodeName = list_to_atom(Username ++ "@localhost"),

    %% Start distribution with short name
    case net_kernel:start([NodeName, shortnames]) of
        {ok, _Pid} ->
            ok;
        {error, {already_started, _Pid}} ->
            ok;
        {error, Reason} ->
            io:format("Failed to start distribution: ~p~n", [Reason]),
            io:format("Continuing without distribution...~n")
    end.
