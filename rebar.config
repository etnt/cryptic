{erl_opts, [debug_info, warnings_as_errors]}.
%%{erl_opts, [debug_info]}.
{deps, [
    {cowboy, "2.9.0"},
    {ranch, "2.1.0"},
    {cowlib, "2.16.0"},
    {gun, "2.0.1"},
    {jsx, "3.1.0"},
    {uuid, "2.0.6", {pkg, uuid_erl}},
    {erl_gpg, ".*",
        {git, "https://github.com/etnt/erl_gpg.git", {branch, "main"}}},
    {esqlite, ".*",
        {git, "https://github.com/mmzeeman/esqlite.git", {branch, "master"}}},
    {lux, {git, "https://github.com/hawk/lux.git", {branch, "master"}}}
]}.

{overrides, [
    {override, cowboy, [{deps, [cowlib, ranch]}]}
]}.

{plugins, [
    {rebar3_lux, ".*",
        {git, "https://github.com/etnt/rebar3_lux.git", {branch, "main"}}}
]}.

{project_plugins, [
    rebar3_lint,
    rebar3_ex_doc,
    erlfmt
]}.

{ex_doc, [
    %% FIXME clean up the docs!
    {extras, [
        "README.md",
        "LICENSE",
        "OVERVIEW.md",
        "docs/DOCKER.md",
        "docs/GPG-BOOTSTRAP.md",
        "docs/X3DH-EXPLAINED.md"
    ]},
    {main, "README.md"},
    {source_url, "https://github.com/etnt/cryptic"}
]}.

{pre_hooks, [
    {"(linux|darwin|solaris)", compile, "make -C c_src"},
    {"(freebsd)", compile, "gmake -C c_src"}
]}.

{post_hooks, [
    {"(linux|darwin|solaris)", clean, "make -C c_src clean"},
    {"(freebsd)", clean, "gmake -C c_src clean"}
]}.

{eunit_opts, [verbose, {report, {eunit_surefire, [{dir, "."}]}}]}.

{shell, [{apps, [cryptic]}]}.

%% Release configuration
{relx, [
    {release, {cryptic, "1.0.0"}, [
        cryptic,
        sasl,
        runtime_tools,
        cowboy,
        ranch,
        cowlib,
        gun,
        jsx,
        uuid,
        esqlite,
        erl_gpg
    ]},
    {vm_args, "config/vm.args"},
    {sys_config, "config/sys.config"},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]},
    {test, [{deps, [meck]}]}
]}.
