#!/bin/bash
#
# cryptic-onboard - Interactive onboarding wizard for Cryptic
#
# This script provides an interactive wizard-style interface for the complete
# Cryptic onboarding process, from GPG key generation to certificate requests.
#
# Usage:
#   cryptic-onboard                         Interactive wizard (recommended)
#   cryptic-onboard export-gpg              Export GPG public key for admin
#   cryptic-onboard request [server_url]    Request certificate from CA
#   cryptic-onboard info [cert_file]        Display certificate information
#   cryptic-onboard generate-gpg            Generate new GPG key pair
#
# Dependencies: curl, openssl, gpg, jq
#
# Author: Cryptic Team
# Date: 2025-11-04

set -e  # Exit on error

# Configuration
CONFIG_DIR="${HOME}/.cryptic"
CONFIG_FILE="${CONFIG_DIR}/config.json"
DEFAULT_SERVER="https://localhost:8443"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
error() {
    echo -e "${RED}Error: $1${NC}" >&2
    exit 1
}

success() {
    echo -e "${GREEN}✓ $1${NC}"
}

info() {
    echo -e "${BLUE}$1${NC}"
}

warn() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

check_dependencies() {
    local missing_deps=()

    for cmd in curl openssl gpg jq; do
        if ! command -v "$cmd" &> /dev/null; then
            missing_deps+=("$cmd")
        fi
    done

    if [ ${#missing_deps[@]} -gt 0 ]; then
        error "Missing required dependencies: ${missing_deps[*]}\nPlease install them and try again."
    fi
}

check_admin_dependencies() {
    local missing_deps=()

    for cmd in qrencode argon2; do
        if ! command -v "$cmd" &> /dev/null; then
            missing_deps+=("$cmd")
        fi
    done

    if [ ${#missing_deps[@]} -gt 0 ]; then
        error "Missing admin dependencies: ${missing_deps[*]}\n\nFor mobile enrollment, install:\n  macOS: brew install qrencode argon2\n  Linux: apt install qrencode argon2"
    fi
}

parse_server_url() {
    local url="$1"

    # Extract host
    SERVER_HOST=$(echo "$url" | sed -E 's|^https?://([^:/]+).*|\1|')

    # Extract port (default to 8443 if not specified)
    SERVER_PORT=$(echo "$url" | sed -E 's|^https?://[^:]+:([0-9]+).*|\1|')
    if [ -z "$SERVER_PORT" ] || [ "$SERVER_PORT" = "$url" ]; then
        SERVER_PORT="8443"
    fi

    if [ -z "$SERVER_HOST" ]; then
        error "Invalid server URL: $url"
    fi
}

draw_box() {
    local text="$1"
    local width=70
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    if [ -n "$text" ]; then
        echo "$text"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    fi
}

generate_gpg_key() {
    info "Generating new GPG key..."
    echo ""
    echo "Please provide the following information:"
    echo ""

    read -p "Real name: " real_name
    if [ -z "$real_name" ]; then
        error "Real name is required"
    fi

    read -p "Email address: " email_addr
    if [ -z "$email_addr" ]; then
        error "Email address is required"
    fi

    read -p "Comment (optional): " comment

    echo ""
    info "Generating GPG key for: $real_name <$email_addr>"
    info "This may take a minute..."
    echo ""

    # Generate key using batch mode for automation
    # Using RSA 4096 as it's widely supported
    # Only include Name-Comment if comment is not empty
    if [ -n "$comment" ]; then
        gpg --batch --gen-key <<EOF
%no-protection
Key-Type: RSA
Key-Length: 4096
Subkey-Type: RSA
Subkey-Length: 4096
Name-Real: $real_name
Name-Email: $email_addr
Name-Comment: $comment
Expire-Date: 2y
%commit
EOF
    else
        gpg --batch --gen-key <<EOF
%no-protection
Key-Type: RSA
Key-Length: 4096
Subkey-Type: RSA
Subkey-Length: 4096
Name-Real: $real_name
Name-Email: $email_addr
Expire-Date: 2y
%commit
EOF
    fi

    if [ $? -eq 0 ]; then
        success "GPG key generated successfully!"
        echo ""
        info "Your new GPG key:"
        gpg --list-keys "$email_addr" 2>/dev/null | head -4
        echo ""
        # Set global variable for the caller to use
        GENERATED_GPG_EMAIL="$email_addr"
    else
        error "Failed to generate GPG key"
    fi
}

select_gpg_key() {
    # Get list of GPG keys with fingerprints
    # Format: fingerprint|uid
    GPG_KEYS_RAW=$(gpg --list-secret-keys --with-colons 2>/dev/null | \
                   awk -F: '
                   /^sec/ {fpr=""}
                   /^fpr/ {fpr=$10}
                   /^uid/ && fpr!="" {print fpr "|" $10; fpr=""}
                   ' | head -10)

    if [ -z "$GPG_KEYS_RAW" ]; then
        warn "No GPG keys found."
        echo ""
        read -p "Would you like to generate a new GPG key? [Y/n]: " gen_key
        gen_key=${gen_key:-Y}
        if [ "$gen_key" = "Y" ] || [ "$gen_key" = "y" ]; then
            generate_gpg_key
            # Use the email from the generated key
            SELECTED_GPG_EMAIL="$GENERATED_GPG_EMAIL"
            if [ -z "$SELECTED_GPG_EMAIL" ]; then
                error "GPG key generation failed or was cancelled"
            fi
            # Get fingerprint for the generated key
            SELECTED_GPG_FP=$(gpg --with-colons --fingerprint "$SELECTED_GPG_EMAIL" 2>/dev/null | \
                             grep "^fpr" | head -1 | cut -d: -f10)
        else
            error "Cannot proceed without a GPG key. Please generate one manually:\n  gpg --full-generate-key"
        fi
        return
    fi

    # Always present a choice menu, even for single key
    KEY_COUNT=$(echo "$GPG_KEYS_RAW" | wc -l | tr -d ' ')

    echo "Available GPG keys:"
    echo ""
    local i=1
    while IFS='|' read -r fp uid; do
        echo "  $i) $uid"
        echo "     Fingerprint: $fp"
        echo ""
        i=$((i + 1))
    done <<< "$GPG_KEYS_RAW"
    echo "  $i) Generate new GPG key"
    local cancel_num=$((i + 1))
    echo "  $cancel_num) Cancel and go back"
    echo ""
    read -p "Select key number [1]: " key_num
    key_num=${key_num:-1}

    if [ "$key_num" -eq "$cancel_num" ]; then
        # User wants to cancel
        SELECTED_GPG_FP=""
        SELECTED_GPG_EMAIL=""
        return 1  # Return error code to indicate cancellation
    elif [ "$key_num" -eq "$i" ]; then
        generate_gpg_key
        SELECTED_GPG_EMAIL="$GENERATED_GPG_EMAIL"
        SELECTED_GPG_FP=$(gpg --with-colons --fingerprint "$SELECTED_GPG_EMAIL" 2>/dev/null | \
                         grep "^fpr" | head -1 | cut -d: -f10)
    elif [ "$key_num" -ge 1 ] && [ "$key_num" -lt "$i" ]; then
        SELECTED_GPG_FP=$(echo "$GPG_KEYS_RAW" | sed -n "${key_num}p" | cut -d'|' -f1)
        SELECTED_GPG_UID=$(echo "$GPG_KEYS_RAW" | sed -n "${key_num}p" | cut -d'|' -f2)
        # Extract email from UID
        SELECTED_GPG_EMAIL=$(echo "$SELECTED_GPG_UID" | grep -oE '[^<]+@[^>]+' | head -1)
        if [ -z "$SELECTED_GPG_EMAIL" ]; then
            SELECTED_GPG_EMAIL="$SELECTED_GPG_UID"
        fi
    else
        error "Invalid selection: $key_num"
    fi
    return 0  # Success
}

#
# Command: create-enrollment
# Generate enrollment package for mobile users (admin use only)
#
cmd_create_enrollment() {
    check_admin_dependencies

    draw_box "Cryptic Admin - Create Mobile Enrollment Package"
    echo ""

    # Parse arguments
    local username=""
    local server_host=""
    local server_port="8443"
    local passphrase=""
    local output_file=""
    local ca_cert_file=""
    local batch_mode=false

    while [[ $# -gt 0 ]]; do
        case $1 in
            --username|-u)
                username="$2"
                shift 2
                ;;
            --server|-s)
                server_host="$2"
                shift 2
                ;;
            --port|-p)
                server_port="$2"
                shift 2
                ;;
            --passphrase)
                passphrase="$2"
                shift 2
                ;;
            --output|-o)
                output_file="$2"
                shift 2
                ;;
            --ca-cert)
                ca_cert_file="$2"
                shift 2
                ;;
            --batch)
                batch_mode=true
                shift
                ;;
            *)
                error "Unknown option: $1\n\nUsage: cryptic-onboard create-enrollment --username <user> --server <host> [options]"
                ;;
        esac
    done

    # Interactive prompts if not in batch mode
    if [ "$batch_mode" = false ]; then
        # Prompt for username
        if [ -z "$username" ]; then
            read -p "Username for mobile user: " username
            if [ -z "$username" ]; then
                error "Username is required"
            fi
        fi

        # Prompt for server
        if [ -z "$server_host" ]; then
            read -p "Server hostname [localhost]: " server_host
            server_host=${server_host:-localhost}
        fi

        # Prompt for port
        read -p "Server port [$server_port]: " input_port
        server_port=${input_port:-$server_port}

        # Prompt for CA cert
        if [ -z "$ca_cert_file" ]; then
            read -p "Path to server CA certificate (optional): " ca_cert_file
        fi

        # Prompt for passphrase
        if [ -z "$passphrase" ]; then
            read -s -p "Enrollment passphrase (keep this secret): " passphrase
            echo ""
            if [ -z "$passphrase" ]; then
                error "Passphrase is required"
            fi
            read -s -p "Confirm passphrase: " passphrase_confirm
            echo ""
            if [ "$passphrase" != "$passphrase_confirm" ]; then
                error "Passphrases do not match"
            fi
        fi
    else
        # Batch mode - require all parameters
        if [ -z "$username" ] || [ -z "$server_host" ] || [ -z "$passphrase" ]; then
            error "Batch mode requires: --username, --server, --passphrase"
        fi
    fi

    # Set default output file
    if [ -z "$output_file" ]; then
        output_file="${username}_enrollment.png"
    fi

    echo ""
    info "Creating enrollment package for: $username"
    info "Server: $server_host:$server_port"
    echo ""

    # Step 1: Check if GPG key exists for username
    GPG_KEY_EXISTS=$(gpg --list-keys "$username" 2>/dev/null || true)
    
    if [ -z "$GPG_KEY_EXISTS" ]; then
        info "No existing GPG key found for $username"
        info "Generating new GPG key..."
        echo ""
        
        # Generate GPG key in batch mode
        # Note: For macOS, we need to use --pinentry-mode loopback to avoid passphrase prompt
        gpg --batch --pinentry-mode loopback --passphrase '' --quick-gen-key "${username}@cryptic.local" rsa2048 default 2y 2>/dev/null
        
        if [ $? -ne 0 ]; then
            # Try alternative method if quick-gen-key fails
            gpg --batch --gen-key <<EOF 2>/dev/null
%no-protection
Key-Type: RSA
Key-Length: 2048
Subkey-Type: RSA
Subkey-Length: 2048
Name-Real: $username
Name-Email: ${username}@cryptic.local
Expire-Date: 2y
%commit
EOF
            if [ $? -ne 0 ]; then
                error "Failed to generate GPG key"
            fi
        fi
        success "GPG key generated for $username"
        echo ""
    else
        success "Using existing GPG key for $username"
        echo ""
    fi

    # Step 2: Export GPG keys
    info "Exporting GPG keys..."
    GPG_PUBLIC=$(gpg --armor --export "$username" 2>/dev/null | base64 | tr -d '\n')
    GPG_PRIVATE=$(gpg --armor --export-secret-keys "$username" 2>/dev/null | base64 | tr -d '\n')
    GPG_KEYID=$(gpg --list-keys --keyid-format=long "$username" 2>/dev/null | grep pub | awk '{print $2}' | cut -d'/' -f2 | head -1)

    if [ -z "$GPG_PUBLIC" ] || [ -z "$GPG_PRIVATE" ] || [ -z "$GPG_KEYID" ]; then
        error "Failed to export GPG keys"
    fi

    # Step 3: Load CA certificate if provided
    CA_CERT_BASE64=""
    if [ -n "$ca_cert_file" ] && [ -f "$ca_cert_file" ]; then
        CA_CERT_BASE64=$(base64 < "$ca_cert_file" | tr -d '\n')
        success "Loaded CA certificate from $ca_cert_file"
    else
        info "No CA certificate provided (will be fetched during enrollment)"
    fi

    # Step 4: Generate enrollment token
    ENROLLMENT_TOKEN=$(uuidgen | tr '[:upper:]' '[:lower:]')

    # Step 5: Create enrollment JSON
    ISSUED_AT=$(date +%s)
    EXPIRES_AT=$((ISSUED_AT + 31536000))  # 1 year

    ENROLLMENT_JSON=$(jq -n \
        --arg username "$username" \
        --arg host "$server_host" \
        --argjson port "$server_port" \
        --arg gpg_pub "$GPG_PUBLIC" \
        --arg gpg_priv "$GPG_PRIVATE" \
        --arg keyid "$GPG_KEYID" \
        --arg token "$ENROLLMENT_TOKEN" \
        --arg ca_cert "$CA_CERT_BASE64" \
        --argjson issued "$ISSUED_AT" \
        --argjson expires "$EXPIRES_AT" \
        '{
            version: 1,
            username: $username,
            server: {
                host: $host,
                port: $port,
                ca_cert: $ca_cert,
                enrollment_token: $token
            },
            gpg_keypair: {
                public_key: $gpg_pub,
                private_key: $gpg_priv,
                key_id: $keyid
            },
            issued_at: $issued,
            expires_at: $expires
        }'
    )

    # Step 6: Encrypt with Argon2 + AES-256-CBC + HMAC
    info "Encrypting enrollment package..."
    
    # Generate salt and IV
    SALT=$(openssl rand -hex 16)
    IV=$(openssl rand -hex 16)
    
    # Derive keys using Argon2id
    # Derive 64 bytes: 32 for encryption key, 32 for HMAC key
    DERIVED_KEYS=$(echo -n "$passphrase" | argon2 "$SALT" -id -t 3 -m 16 -p 4 -l 64 -r)
    
    if [ -z "$DERIVED_KEYS" ]; then
        error "Failed to derive encryption keys"
    fi
    
    # Split into encryption key and HMAC key
    ENC_KEY="${DERIVED_KEYS:0:64}"   # First 32 bytes (64 hex chars)
    HMAC_KEY="${DERIVED_KEYS:64:64}" # Next 32 bytes (64 hex chars)

    # Encrypt the enrollment JSON using AES-256-CBC
    TEMP_PLAIN=$(mktemp)
    TEMP_CIPHER=$(mktemp)
    echo -n "$ENROLLMENT_JSON" > "$TEMP_PLAIN"
    
    openssl enc -aes-256-cbc -K "$ENC_KEY" -iv "$IV" -in "$TEMP_PLAIN" -out "$TEMP_CIPHER" 2>/dev/null
    
    if [ $? -ne 0 ]; then
        rm -f "$TEMP_PLAIN" "$TEMP_CIPHER"
        error "Failed to encrypt enrollment package"
    fi
    
    # Read encrypted data and encode as base64
    CIPHERTEXT=$(base64 < "$TEMP_CIPHER" | tr -d '\n')
    
    # Calculate HMAC over ciphertext for authenticity
    HMAC=$(echo -n "$CIPHERTEXT" | openssl dgst -sha256 -mac hmac -macopt "hexkey:$HMAC_KEY" | awk '{print $2}')
    
    rm -f "$TEMP_PLAIN" "$TEMP_CIPHER"
    
    if [ -z "$CIPHERTEXT" ] || [ -z "$HMAC" ]; then
        error "Failed to encrypt and authenticate enrollment package"
    fi

    # Step 7: Create QR payload
    QR_PAYLOAD=$(jq -n \
        --arg salt "$SALT" \
        --arg iv "$IV" \
        --arg cipher "$CIPHERTEXT" \
        --arg hmac "$HMAC" \
        '{v: 1, salt: $salt, iv: $iv, ciphertext: $cipher, hmac: $hmac}'
    )

    # Check payload size
    PAYLOAD_SIZE=$(echo -n "$QR_PAYLOAD" | wc -c | tr -d ' ')
    if [ "$PAYLOAD_SIZE" -gt 2953 ]; then
        warn "Payload size ($PAYLOAD_SIZE bytes) exceeds ideal QR code capacity (2953 bytes)"
        warn "QR code generation may fail or require special scanning app"
        echo ""
    fi

    # Step 8: Generate QR code
    info "Generating QR code..."
    if echo -n "$QR_PAYLOAD" | qrencode -o "$output_file" -s 10 -l L -m 2 2>/dev/null; then
        success "QR code generated successfully!"
    elif echo -n "$QR_PAYLOAD" | qrencode -o "$output_file" -s 8 -l L -m 1 2>/dev/null; then
        success "QR code generated with reduced size!"
    else
        # Last resort: save as text file for manual entry or alternative encoding
        TEXT_FILE="${output_file%.png}.txt"
        echo -n "$QR_PAYLOAD" > "$TEXT_FILE"
        warn "QR code too large to generate. Saved payload to: $TEXT_FILE"
        warn "Consider using alternative delivery method (file transfer, NFC, etc.)"
        output_file="$TEXT_FILE"
    fi

    echo ""
    success "Enrollment package created successfully!"
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "QR Code:            $output_file"
    echo "Username:           $username"
    echo "Server:             $server_host:$server_port"
    echo "Enrollment Token:   $ENROLLMENT_TOKEN"
    echo "Payload Size:       $PAYLOAD_SIZE bytes"
    echo "Expires:            $(date -r $EXPIRES_AT '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date -d @$EXPIRES_AT '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    warn "Important: Store the enrollment token on the server for validation!"
    info "Share the QR code and passphrase with the user via secure channels."
    echo ""
}

#
# Command: create-mobile-enrollment
# Generate Ed25519-based enrollment package for mobile users (admin use only)
# Uses v2 payload format that fits in a single QR code
#
cmd_create_mobile_enrollment() {
    check_admin_dependencies

    draw_box "Cryptic Admin - Create Mobile Enrollment Package (Ed25519)"
    echo ""

    # Parse arguments
    local username=""
    local server_url=""
    local server_host=""
    local server_port="8443"
    local passphrase=""
    local output_file=""
    local admin_cert=""
    local admin_key=""
    local ca_cert_file=""
    local batch_mode=false

    while [[ $# -gt 0 ]]; do
        case $1 in
            --username|-u)
                username="$2"
                shift 2
                ;;
            --server|-s)
                server_url="$2"
                shift 2
                ;;
            --port|-p)
                server_port="$2"
                shift 2
                ;;
            --passphrase)
                passphrase="$2"
                shift 2
                ;;
            --output|-o)
                output_file="$2"
                shift 2
                ;;
            --admin-cert)
                admin_cert="$2"
                shift 2
                ;;
            --admin-key)
                admin_key="$2"
                shift 2
                ;;
            --ca-cert)
                ca_cert_file="$2"
                shift 2
                ;;
            --batch)
                batch_mode=true
                shift
                ;;
            *)
                error "Unknown option: $1\n\nUsage: cryptic-onboard create-mobile-enrollment --username <user> --server <host> [options]"
                ;;
        esac
    done

    # Interactive prompts if not in batch mode
    if [ "$batch_mode" = false ]; then
        if [ -z "$username" ]; then
            read -p "Username for mobile user: " username
            if [ -z "$username" ]; then
                error "Username is required"
            fi
        fi

        if [ -z "$server_url" ]; then
            read -p "Server URL [https://localhost:8443]: " server_url
            server_url=${server_url:-https://localhost:8443}
        fi

        if [ -z "$admin_cert" ]; then
            read -p "Path to admin client certificate: " admin_cert
            if [ -z "$admin_cert" ] || [ ! -f "$admin_cert" ]; then
                error "Admin client certificate is required for registration"
            fi
        fi

        if [ -z "$admin_key" ]; then
            read -p "Path to admin client key: " admin_key
            if [ -z "$admin_key" ] || [ ! -f "$admin_key" ]; then
                error "Admin client key is required for registration"
            fi
        fi

        if [ -z "$ca_cert_file" ]; then
            read -p "Path to CA certificate: " ca_cert_file
        fi

        if [ -z "$passphrase" ]; then
            read -s -p "Enrollment passphrase (share with user securely): " passphrase
            echo ""
            if [ -z "$passphrase" ]; then
                error "Passphrase is required"
            fi
            read -s -p "Confirm passphrase: " passphrase_confirm
            echo ""
            if [ "$passphrase" != "$passphrase_confirm" ]; then
                error "Passphrases do not match"
            fi
        fi
    else
        if [ -z "$username" ] || [ -z "$server_url" ] || [ -z "$passphrase" ] || [ -z "$admin_cert" ] || [ -z "$admin_key" ]; then
            error "Batch mode requires: --username, --server, --passphrase, --admin-cert, --admin-key"
        fi
    fi

    # Parse server URL into host and port
    parse_server_url "$server_url"

    # Set default output file
    if [ -z "$output_file" ]; then
        output_file="${username}_mobile_enrollment.png"
    fi

    echo ""
    info "Creating mobile enrollment package for: $username"
    info "Server: $SERVER_HOST:$SERVER_PORT"
    echo ""

    # Step 1: Generate Ed25519 keypair
    info "Generating Ed25519 enrollment keypair..."
    TEMP_ED_KEY=$(mktemp)
    TEMP_ED_PUB=$(mktemp)

    openssl genpkey -algorithm ed25519 -out "$TEMP_ED_KEY" 2>/dev/null
    if [ $? -ne 0 ]; then
        rm -f "$TEMP_ED_KEY" "$TEMP_ED_PUB"
        error "Failed to generate Ed25519 keypair"
    fi

    openssl pkey -in "$TEMP_ED_KEY" -pubout -out "$TEMP_ED_PUB" 2>/dev/null

    # Extract raw 32-byte public key (skip PEM/DER headers)
    ED_PUB_RAW_B64=$(openssl pkey -in "$TEMP_ED_KEY" -pubout -outform DER 2>/dev/null | tail -c 32 | base64 | tr -d '\n')
    # Extract raw 64-byte secret key (32 seed + 32 pub, or just 32-byte seed depending on openssl version)
    ED_SEC_RAW_B64=$(openssl pkey -in "$TEMP_ED_KEY" -outform DER 2>/dev/null | tail -c 64 | base64 | tr -d '\n')

    rm -f "$TEMP_ED_KEY" "$TEMP_ED_PUB"

    if [ -z "$ED_PUB_RAW_B64" ] || [ -z "$ED_SEC_RAW_B64" ]; then
        error "Failed to extract Ed25519 key material"
    fi

    # Compute fingerprint = SHA-256 of raw public key bytes (hex)
    ED_PUB_RAW=$(echo -n "$ED_PUB_RAW_B64" | base64 -d)
    ENROLLMENT_FP=$(echo -n "$ED_PUB_RAW_B64" | base64 -d | openssl dgst -sha256 -hex 2>/dev/null | awk '{print $NF}')

    if [ -z "$ENROLLMENT_FP" ]; then
        error "Failed to compute enrollment fingerprint"
    fi

    success "Ed25519 keypair generated"
    info "Fingerprint: $ENROLLMENT_FP"
    echo ""

    # Step 2: Get CA certificate fingerprint
    CA_FP=""
    if [ -n "$ca_cert_file" ] && [ -f "$ca_cert_file" ]; then
        CA_FP=$(openssl x509 -in "$ca_cert_file" -outform DER 2>/dev/null | openssl dgst -sha256 -hex 2>/dev/null | awk '{print $NF}')
        success "CA certificate fingerprint: $CA_FP"
    else
        info "No CA certificate provided — will try to fetch from server"
        # Try to fetch from the server's ca-cert endpoint
        TEMP_CA=$(mktemp)
        if curl -sk "${server_url}/ca/v1/ca-cert" -o "$TEMP_CA" 2>/dev/null; then
            if [ -s "$TEMP_CA" ] && grep -q "BEGIN CERTIFICATE" "$TEMP_CA"; then
                CA_FP=$(openssl x509 -in "$TEMP_CA" -outform DER 2>/dev/null | openssl dgst -sha256 -hex 2>/dev/null | awk '{print $NF}')
                success "Fetched CA certificate fingerprint: $CA_FP"
            fi
        fi
        rm -f "$TEMP_CA"

        if [ -z "$CA_FP" ]; then
            warn "Could not obtain CA certificate fingerprint"
            warn "Mobile client will skip CA verification (less secure)"
        fi
    fi
    echo ""

    # Step 3: Register enrollment key on the server
    info "Registering enrollment key on server..."
    REGISTER_JSON=$(jq -n \
        --arg fp "$ENROLLMENT_FP" \
        --arg pub "$ED_PUB_RAW_B64" \
        --arg user "$username" \
        '{enrollment_fp: $fp, enrollment_pub_b64: $pub, username: $user}'
    )

    # Build curl args for mTLS
    CURL_ARGS=(-s -X POST)
    CURL_ARGS+=(-H "Content-Type: application/json")
    CURL_ARGS+=(-d "$REGISTER_JSON")
    CURL_ARGS+=(--cert "$admin_cert")
    CURL_ARGS+=(--key "$admin_key")
    if [ -n "$ca_cert_file" ] && [ -f "$ca_cert_file" ]; then
        CURL_ARGS+=(--cacert "$ca_cert_file")
    else
        CURL_ARGS+=(-k)
    fi
    CURL_ARGS+=("${server_url}/ca/v1/admin/register-enrollment")

    REGISTER_RESP=$(curl "${CURL_ARGS[@]}" 2>/dev/null)
    REGISTER_STATUS=$(echo "$REGISTER_RESP" | jq -r '.status // empty' 2>/dev/null)

    if [ "$REGISTER_STATUS" != "registered" ]; then
        REGISTER_ERR=$(echo "$REGISTER_RESP" | jq -r '.message // .error // "Unknown error"' 2>/dev/null)
        error "Failed to register enrollment key on server: $REGISTER_ERR"
    fi

    success "Enrollment key registered on server"
    echo ""

    # Step 4: Build v2 enrollment payload JSON
    ISSUED_AT=$(date +%s)
    EXPIRES_AT=$((ISSUED_AT + 31536000))  # 1 year

    PAYLOAD_JSON=$(jq -n \
        --arg username "$username" \
        --arg host "$SERVER_HOST" \
        --argjson port "$server_port" \
        --arg ca_fp "$CA_FP" \
        --arg e_pub "$ED_PUB_RAW_B64" \
        --arg e_sec "$ED_SEC_RAW_B64" \
        --argjson issued "$ISSUED_AT" \
        --argjson expires "$EXPIRES_AT" \
        '{
            username: $username,
            server_host: $host,
            server_port: $port,
            ca_fingerprint: $ca_fp,
            enrollment_pub: $e_pub,
            enrollment_sec: $e_sec,
            issued_at: $issued,
            expires_at: $expires
        }'
    )

    # Step 5: Encrypt with Argon2id + AES-256-CBC + HMAC-SHA256
    info "Encrypting enrollment package..."

    SALT=$(openssl rand -hex 16)
    IV=$(openssl rand -hex 16)

    # Derive 64 bytes: 32 for AES key, 32 for HMAC key
    DERIVED_KEYS=$(echo -n "$passphrase" | argon2 "$SALT" -id -t 3 -m 16 -p 4 -l 64 -r)

    if [ -z "$DERIVED_KEYS" ]; then
        error "Failed to derive encryption keys"
    fi

    ENC_KEY="${DERIVED_KEYS:0:64}"
    HMAC_KEY="${DERIVED_KEYS:64:64}"

    TEMP_PLAIN=$(mktemp)
    TEMP_CIPHER=$(mktemp)
    echo -n "$PAYLOAD_JSON" > "$TEMP_PLAIN"

    openssl enc -aes-256-cbc -K "$ENC_KEY" -iv "$IV" -in "$TEMP_PLAIN" -out "$TEMP_CIPHER" 2>/dev/null

    if [ $? -ne 0 ]; then
        rm -f "$TEMP_PLAIN" "$TEMP_CIPHER"
        error "Failed to encrypt enrollment package"
    fi

    CIPHERTEXT=$(base64 < "$TEMP_CIPHER" | tr -d '\n')
    HMAC=$(echo -n "$CIPHERTEXT" | openssl dgst -sha256 -mac hmac -macopt "hexkey:$HMAC_KEY" | awk '{print $2}')

    rm -f "$TEMP_PLAIN" "$TEMP_CIPHER"

    if [ -z "$CIPHERTEXT" ] || [ -z "$HMAC" ]; then
        error "Failed to encrypt and authenticate enrollment package"
    fi

    # Step 6: Build QR envelope (v2 format)
    QR_PAYLOAD=$(jq -n \
        --arg salt "$SALT" \
        --arg iv "$IV" \
        --arg cipher "$CIPHERTEXT" \
        --arg hmac "$HMAC" \
        '{v: 2, salt: $salt, iv: $iv, ct: $cipher, hmac: $hmac}'
    )

    PAYLOAD_SIZE=$(echo -n "$QR_PAYLOAD" | wc -c | tr -d ' ')

    # Step 7: Generate QR code
    info "Generating QR code ($PAYLOAD_SIZE bytes)..."
    if [ "$PAYLOAD_SIZE" -gt 2953 ]; then
        warn "Payload ($PAYLOAD_SIZE bytes) exceeds QR V40-L capacity (2953 bytes)"
        warn "Consider shorter username or check key sizes"
    fi

    if echo -n "$QR_PAYLOAD" | qrencode -o "$output_file" -s 10 -l L -m 2 2>/dev/null; then
        success "QR code generated successfully!"
    elif echo -n "$QR_PAYLOAD" | qrencode -o "$output_file" -s 8 -l L -m 1 2>/dev/null; then
        success "QR code generated with reduced size!"
    else
        TEXT_FILE="${output_file%.png}.json"
        echo -n "$QR_PAYLOAD" > "$TEXT_FILE"
        warn "QR code too large. Saved payload to: $TEXT_FILE"
        output_file="$TEXT_FILE"
    fi

    echo ""
    success "Mobile enrollment package created successfully!"
    echo ""
    draw_box ""
    echo "QR Code:            $output_file"
    echo "Username:           $username"
    echo "Server:             $SERVER_HOST:$SERVER_PORT"
    echo "Enrollment FP:      $ENROLLMENT_FP"
    echo "Payload Size:       $PAYLOAD_SIZE bytes"
    echo "Payload Version:    2 (Ed25519)"
    echo "Expires:            $(date -r $EXPIRES_AT '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date -d @$EXPIRES_AT '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
    draw_box ""
    echo ""
    info "Share the QR code and passphrase with the user via separate secure channels."
    warn "The passphrase should NEVER be sent alongside the QR code."
    echo ""
}

#
# Command: export-gpg
# Export GPG public key for admin registration
#
cmd_export_gpg() {
    draw_box "Cryptic Onboarding - Step 1: Export GPG Public Key"
    echo ""

    info "This command helps you export your GPG public key so an admin"
    info "can register you in the Cryptic system."
    echo ""

    # Step 1: Select GPG key
    if ! select_gpg_key; then
        echo ""
        info "Operation cancelled."
        return 0
    fi

    # Defensive guard in case selection returned without setting globals
    if [ -z "$SELECTED_GPG_FP" ]; then
        echo ""
        info "Operation cancelled."
        return 0
    fi

    GPG_FP="$SELECTED_GPG_FP"
    GPG_EMAIL="$SELECTED_GPG_EMAIL"

    echo ""
    success "Selected GPG key:"
    echo "  UID:         $GPG_EMAIL"
    echo "  Fingerprint: $GPG_FP"
    echo ""

    # Step 2: Export public key
    info "Exporting GPG public key..."
    GPG_PUBKEY=$(gpg --armor --export "$GPG_FP" 2>/dev/null)
    if [ -z "$GPG_PUBKEY" ]; then
        error "Failed to export GPG public key"
    fi

    # Save to file
    OUTPUT_DIR="${CONFIG_DIR}/gpg-export"
    mkdir -p "$OUTPUT_DIR"
    OUTPUT_FILE="${OUTPUT_DIR}/gpg-public-${GPG_FP}.asc"

    echo "$GPG_PUBKEY" > "$OUTPUT_FILE"
    success "GPG public key exported to: $OUTPUT_FILE"
    echo ""

    # Extract username from email
    USERNAME=$(echo "$GPG_EMAIL" | sed 's/@.*//')
    if [ -z "$USERNAME" ]; then
        USERNAME="user"
    fi

    # Save config for later use (per-user)
    USER_DIR="${CONFIG_DIR}/${USERNAME}"
    USER_CONFIG="${USER_DIR}/config.json"
    mkdir -p "$USER_DIR"
    jq -n \
        --arg fp "$GPG_FP" \
        --arg email "$GPG_EMAIL" \
        --arg user "$USERNAME" \
        '{gpg_fingerprint: $fp, gpg_email: $email, username: $user}' \
        > "$USER_CONFIG"

    # Also save as global last-used config for convenience
    jq -n \
        --arg user "$USERNAME" \
        '{last_user: $user}' \
        > "$CONFIG_FILE"

    draw_box ""
    echo ""
    info "Next steps:"
    echo ""
    echo "  1. Send your GPG public key to a Cryptic administrator:"
    echo "     File: $OUTPUT_FILE"
    echo ""
    echo "  2. Include this information in your request:"
    echo "     - Your name"
    echo "     - GPG Fingerprint: $GPG_FP"
    echo ""
    echo "  3. Once the admin registers your GPG key, run:"
    echo "     cryptic-onboard request [server_url]"
    echo ""

    draw_box ""
}

#
# Command: request [server_url]
# Requests TLS certificate from CA (admin must have registered your GPG key first)
#
cmd_request() {
    local server_url="$1"

    draw_box "Cryptic Onboarding - Step 2: Request Certificate"
    echo ""

    # Try to determine username from global config or prompt
    LAST_USER=""
    if [ -f "$CONFIG_FILE" ]; then
        LAST_USER=$(jq -r '.last_user // empty' "$CONFIG_FILE")
    fi

    # List available user configs
    AVAILABLE_USERS=$(find "$CONFIG_DIR" -maxdepth 1 -type d ! -path "$CONFIG_DIR" ! -path "*/gpg-export" -exec basename {} \; 2>/dev/null)

    if [ -n "$AVAILABLE_USERS" ]; then
        USER_COUNT=$(echo "$AVAILABLE_USERS" | wc -l | tr -d ' ')

        if [ "$USER_COUNT" -eq 1 ]; then
            USERNAME=$(echo "$AVAILABLE_USERS" | head -1)
            info "Found identity: $USERNAME"
        elif [ -n "$LAST_USER" ] && echo "$AVAILABLE_USERS" | grep -q "^${LAST_USER}$"; then
            USERNAME="$LAST_USER"
            info "Using last identity: $USERNAME"
        else
            echo "Available identities:"
            echo "$AVAILABLE_USERS" | nl
            echo ""
            read -p "Select identity number [1]: " user_num
            user_num=${user_num:-1}
            USERNAME=$(echo "$AVAILABLE_USERS" | sed -n "${user_num}p")
        fi

        USER_CONFIG="${CONFIG_DIR}/${USERNAME}/config.json"

        if [ -f "$USER_CONFIG" ]; then
            GPG_FP=$(jq -r '.gpg_fingerprint // empty' "$USER_CONFIG")
            GPG_EMAIL=$(jq -r '.gpg_email // empty' "$USER_CONFIG")

            # Validate that the stored fingerprint exists and matches the stored email
            VERIFY_EMAIL=""
            if [ -n "$GPG_FP" ]; then
                # Get email associated with this fingerprint in GPG keyring
                VERIFY_EMAIL=$(gpg --list-keys --with-colons "$GPG_FP" 2>/dev/null | \
                              awk -F: '/^uid/ {print $10}' | head -1 | \
                              grep -oE '[^<]+@[^>]+' | head -1)
            fi

            if [ -z "$GPG_FP" ] || [ -z "$GPG_EMAIL" ] || [ "$VERIFY_EMAIL" != "$GPG_EMAIL" ]; then
                if [ -n "$GPG_FP" ] && [ -n "$VERIFY_EMAIL" ] && [ "$VERIFY_EMAIL" != "$GPG_EMAIL" ]; then
                    warn "Config mismatch! Stored email ($GPG_EMAIL) doesn't match GPG key ($VERIFY_EMAIL)"
                else
                    warn "Invalid or incomplete user config."
                fi
                echo ""
                if ! select_gpg_key; then
                    echo ""
                    info "Operation cancelled."
                    return 0
                fi
                GPG_FP="$SELECTED_GPG_FP"
                GPG_EMAIL="$SELECTED_GPG_EMAIL"
                USERNAME=$(echo "$GPG_EMAIL" | sed 's/@.*//')
            fi

            echo ""
            info "Using GPG key from config:"
            echo "  Username:    $USERNAME"
            echo "  UID:         $GPG_EMAIL"
            echo "  Fingerprint: $GPG_FP"
        else
            warn "Config not found for user: $USERNAME"
            if ! select_gpg_key; then
                echo ""
                info "Operation cancelled."
                return 0
            fi
            GPG_FP="$SELECTED_GPG_FP"
            GPG_EMAIL="$SELECTED_GPG_EMAIL"
            USERNAME=$(echo "$GPG_EMAIL" | sed 's/@.*//')

            echo ""
            success "Selected GPG key:"
            echo "  Username:    $USERNAME"
            echo "  UID:         $GPG_EMAIL"
            echo "  Fingerprint: $GPG_FP"
        fi
    else
        warn "No saved identities found. Run 'cryptic-onboard export-gpg' first."
        echo ""
        info "Continuing without saved configuration..."
        if ! select_gpg_key; then
            echo ""
            info "Operation cancelled."
            return 0
        fi

        if [ -z "$SELECTED_GPG_FP" ]; then
            error "No GPG key selected"
        fi

        GPG_FP="$SELECTED_GPG_FP"
        GPG_EMAIL="$SELECTED_GPG_EMAIL"

        # Extract username from email
        USERNAME=$(echo "$GPG_EMAIL" | sed 's/@.*//')
        if [ -z "$USERNAME" ]; then
            USERNAME="user"
        fi

        echo ""
        success "Selected GPG key:"
        echo "  Username:    $USERNAME"
        echo "  UID:         $GPG_EMAIL"
        echo "  Fingerprint: $GPG_FP"
    fi

    # Use provided server or default
    if [ -z "$server_url" ]; then
        # Try to find server-specific config for this user
        SERVER_CONFIGS=$(find "${CONFIG_DIR}/${USERNAME}" -maxdepth 1 -type d ! -path "${CONFIG_DIR}/${USERNAME}" -exec basename {} \; 2>/dev/null)

        if [ -n "$SERVER_CONFIGS" ]; then
            # If there's a default_server in user config, use it
            if [ -f "$USER_CONFIG" ]; then
                server_url=$(jq -r '.default_server // empty' "$USER_CONFIG")
            fi

            # If still no server URL, list available servers
            if [ -z "$server_url" ]; then
                SERVER_COUNT=$(echo "$SERVER_CONFIGS" | wc -l | tr -d ' ')
                if [ "$SERVER_COUNT" -eq 1 ]; then
                    SERVER_DIR=$(echo "$SERVER_CONFIGS" | head -1)
                    # Extract server URL from directory name (format: host_port)
                    server_url="https://$(echo "$SERVER_DIR" | sed 's/_/:/')"
                else
                    echo ""
                    echo "Previous servers for $USERNAME:"
                    echo "$SERVER_CONFIGS" | nl
                    echo ""
                    read -p "Select server number or enter new URL [$DEFAULT_SERVER]: " choice

                    if [ -z "$choice" ]; then
                        server_url="$DEFAULT_SERVER"
                    elif [[ "$choice" =~ ^[0-9]+$ ]]; then
                        SERVER_DIR=$(echo "$SERVER_CONFIGS" | sed -n "${choice}p")
                        server_url="https://$(echo "$SERVER_DIR" | sed 's/_/:/')"
                    else
                        server_url="$choice"
                    fi
                fi
            fi
        fi

        # Final fallback to prompt
        if [ -z "$server_url" ]; then
            echo ""
            info "CA Server Configuration"
            echo ""
            read -p "Server hostname [localhost]: " server_host
            server_host=${server_host:-localhost}

            read -p "Server port [8443]: " server_port
            server_port=${server_port:-8443}

            server_url="https://${server_host}:${server_port}"
        fi
    fi

    parse_server_url "$server_url"

    echo ""
    info "Server: ${SERVER_HOST}:${SERVER_PORT}"

    # Extract username from email (part before @)
    # If email doesn't have @, use the whole string
    USERNAME=$(echo "$GPG_EMAIL" | sed 's/@.*//')
    if [ -z "$USERNAME" ]; then
        USERNAME="user"
    fi

    echo ""
    info "Username: $USERNAME"
    echo ""

    # Create directory structure with username
    CERT_DIR="${CONFIG_DIR}/${USERNAME}/${SERVER_HOST}_${SERVER_PORT}"
    CERT_SUBDIR="${CERT_DIR}/certificates"
    mkdir -p "$CERT_SUBDIR"

    # Use username-based file names to match cryptic_console expectations
    KEY_FILE="${CERT_SUBDIR}/${USERNAME}.key"
    CSR_FILE="${CERT_SUBDIR}/${USERNAME}.csr"
    CERT_FILE="${CERT_SUBDIR}/${USERNAME}.crt"

    # Step 1: Generate TLS key pair
    info "[1/4] Generating TLS key pair (ECDSA secp384r1)..."
    if [ ! -f "$KEY_FILE" ]; then
        openssl ecparam -genkey -name secp384r1 -out "$KEY_FILE" 2>/dev/null
        chmod 600 "$KEY_FILE"
        success "TLS key pair generated"
    else
        success "Using existing TLS key"
    fi

    # Step 2: Create CSR with GPG fingerprint in CN and email in SAN
    info "[2/4] Creating Certificate Signing Request (CSR)..."

    # Create a temporary config file for SAN extension
    TMP_OPENSSL_CNF=$(mktemp)
    cat > "$TMP_OPENSSL_CNF" <<EOF
[req]
distinguished_name = req_distinguished_name
req_extensions = v3_req

[req_distinguished_name]

[v3_req]
subjectAltName = @alt_names

[alt_names]
DNS.1 = ${GPG_FP}.gpg.cryptic.local
email.1 = ${GPG_EMAIL}
EOF

    openssl req -new -key "$KEY_FILE" \
        -subj "/CN=${GPG_FP}.gpg.cryptic.local" \
        -config "$TMP_OPENSSL_CNF" \
        -out "$CSR_FILE" 2>/dev/null

    # Clean up temp config
    rm -f "$TMP_OPENSSL_CNF"

    success "CSR created with email: ${GPG_EMAIL}"

    # Debug: Print full CSR details to verify SAN extension
    if command -v openssl >/dev/null 2>&1; then
        echo ""
        info "CSR Details (full text):"
        echo "=================================="
        openssl req -in "$CSR_FILE" -noout -text 2>/dev/null
        echo "=================================="
        echo ""
    fi

    # Step 3: Sign CSR with GPG key
    info "[3/4] Signing CSR with GPG key (fingerprint: ${GPG_FP:0:16}...)..."
    # Read CSR data - preserve exact bytes including any trailing newline
    CSR_DATA=$(cat "$CSR_FILE"; echo x)
    CSR_DATA=${CSR_DATA%x}
    # Use fingerprint with ! suffix to force exact key match
    # Sign the exact CSR data we're going to send
    # Set GPG_TTY so pinentry knows which terminal to use for passphrase prompt
    export GPG_TTY=$(tty)
    # Redirect stderr to terminal (not /dev/null) so passphrase prompts appear
    GPG_SIG=$(printf '%s' "$CSR_DATA" | gpg --armor --detach-sign --local-user "${GPG_FP}!" 2>/dev/tty)
    if [ $? -ne 0 ]; then
        echo ""
        error "Failed to sign CSR with GPG key.\n\nFingerprint: $GPG_FP\nUID: $GPG_EMAIL\n\nMake sure you have the private key and it's not expired."
    fi
    success "CSR signed with GPG"

    # Step 4: Submit to CA
    CA_REST_URL="https://${SERVER_HOST}:${SERVER_PORT}"
    info "[4/4] Submitting to CA: ${CA_REST_URL}"

    # Create JSON payload
    GPG_SIG_B64=$(printf '%s' "$GPG_SIG" | base64 | tr -d '\n')
    JSON_PAYLOAD=$(jq -n \
        --arg csr "$CSR_DATA" \
        --arg fp "$GPG_FP" \
        --arg sig "$GPG_SIG_B64" \
        '{csr_pem: $csr, gpg_fp: $fp, gpg_sig_b64: $sig}')

    # Make API call
    # Note: Using -k for self-signed certificates in development
    # In production, you should use --cacert with the CA certificate
    RESPONSE=$(curl -k -s -w "\n%{http_code}" -X POST "${CA_REST_URL}/ca/v1/csr" \
        -H "Content-Type: application/json" \
        -d "$JSON_PAYLOAD" 2>/dev/null || echo "000")

    HTTP_CODE=$(echo "$RESPONSE" | tail -1)
    BODY=$(echo "$RESPONSE" | sed '$d')

    if [ "$HTTP_CODE" != "200" ]; then
        echo ""
        error "Certificate request failed (HTTP $HTTP_CODE)\n\nResponse: $BODY\n\nPossible reasons:\n  - Admin has not registered your GPG key yet\n  - Your account has been suspended or revoked\n  - Network/server issue\n\nPlease contact your Cryptic administrator."
    fi

    # Save certificate
    CERT_PEM=$(echo "$BODY" | jq -r '.cert_pem // empty')
    if [ -z "$CERT_PEM" ]; then
        error "No certificate in response"
    fi

    echo "$CERT_PEM" > "$CERT_FILE"
    success "Certificate issued successfully!"
    echo ""

    # Download and save CA certificate for server verification
    CA_CERT_FILE="${CERT_SUBDIR}/ca.crt"
    info "Downloading CA certificate for server verification..."

    # Try to get CA cert from server (if endpoint exists) or use -k and warn
    CA_CERT_PEM=$(curl -k -s "${CA_REST_URL}/ca/v1/ca-cert" 2>/dev/null)

    if [ -n "$CA_CERT_PEM" ] && echo "$CA_CERT_PEM" | grep -q "BEGIN CERTIFICATE"; then
        echo "$CA_CERT_PEM" > "$CA_CERT_FILE"
        success "CA certificate downloaded"
    else
        # Fallback: try to copy from local CA directory if running locally
        if [ -f "priv/ssl/ca.crt" ]; then
            cp "priv/ssl/ca.crt" "$CA_CERT_FILE"
            success "CA certificate copied from local CA"
        elif [ -f "../priv/ssl/ca.crt" ]; then
            cp "../priv/ssl/ca.crt" "$CA_CERT_FILE"
            success "CA certificate copied from local CA"
        else
            warn "Could not retrieve CA certificate. Server verification will be disabled."
            warn "You can manually copy the CA certificate to: $CA_CERT_FILE"
        fi
    fi
    echo ""

    # Parse certificate info
    SERIAL=$(openssl x509 -in "$CERT_FILE" -noout -serial 2>/dev/null | cut -d= -f2)
    SUBJECT=$(openssl x509 -in "$CERT_FILE" -noout -subject 2>/dev/null | cut -d= -f2-)
    NOT_BEFORE=$(openssl x509 -in "$CERT_FILE" -noout -startdate 2>/dev/null | cut -d= -f2)
    NOT_AFTER=$(openssl x509 -in "$CERT_FILE" -noout -enddate 2>/dev/null | cut -d= -f2)
    EXPIRES_AT=$(echo "$BODY" | jq -r '.expires_at // empty')
    VALIDITY_DAYS=$(echo "$BODY" | jq -r '.validity_days // 7')

    echo "Certificate Details:"
    echo "  Serial:        $SERIAL"
    echo "  Subject:       $SUBJECT"
    echo "  Issuer:        CN=Cryptic CA"
    echo "  Valid From:    $NOT_BEFORE"
    echo "  Valid Until:   $NOT_AFTER"
    echo "  Validity:      $VALIDITY_DAYS days"
    echo ""
    echo "Files:"
    echo "  Certificate:   $CERT_FILE"
    echo "  Private Key:   $KEY_FILE"
    if [ -f "$CA_CERT_FILE" ]; then
        echo "  CA Cert:       $CA_CERT_FILE"
    fi
    echo ""
    echo "Directory structure:"
    echo "  ${CERT_DIR}/"
    echo "    └── certificates/"
    echo "        ├── ${USERNAME}.crt"
    echo "        ├── ${USERNAME}.key"
    echo "        ├── ${USERNAME}.csr"
    if [ -f "$CA_CERT_FILE" ]; then
        echo "        └── ca.crt"
    fi
    echo ""

    # Save server-specific config for this user/server combination
    SERVER_CONFIG="${CERT_DIR}/config.json"
    jq -n \
        --arg fp "$GPG_FP" \
        --arg email "$GPG_EMAIL" \
        --arg user "$USERNAME" \
        --arg server "$server_url" \
        --arg host "$SERVER_HOST" \
        --arg port "$SERVER_PORT" \
        '{gpg_fingerprint: $fp, gpg_email: $email, username: $user, server_url: $server, server_host: $host, server_port: $port}' \
        > "$SERVER_CONFIG"

    # Update user-level config with default server
    if [ -f "$USER_CONFIG" ]; then
        TEMP_FILE="${USER_CONFIG}.tmp"
        jq --arg server "$server_url" '.default_server = $server' "$USER_CONFIG" > "$TEMP_FILE"
        mv "$TEMP_FILE" "$USER_CONFIG"
    else
        mkdir -p "$(dirname "$USER_CONFIG")"
        jq -n \
            --arg fp "$GPG_FP" \
            --arg email "$GPG_EMAIL" \
            --arg user "$USERNAME" \
            --arg server "$server_url" \
            '{gpg_fingerprint: $fp, gpg_email: $email, username: $user, default_server: $server}' \
            > "$USER_CONFIG"
    fi

    # Update global config with last used username
    jq -n --arg user "$USERNAME" '{last_user: $user}' > "$CONFIG_FILE"

    draw_box ""
    echo ""
    info "Next steps:"
    echo ""
    echo "  1. Connect to Cryptic using your certificate:"
    if [ -f "$CA_CERT_FILE" ]; then
        echo "     cryptic-console --username $USERNAME \\"
        echo "                     --cert $CERT_FILE \\"
        echo "                     --key $KEY_FILE \\"
        echo "                     --cacert $CA_CERT_FILE \\"
        echo "                     connect wss://${SERVER_HOST}:${SERVER_PORT}"
    else
        echo "     cryptic-console --username $USERNAME \\"
        echo "                     --cert $CERT_FILE \\"
        echo "                     --key $KEY_FILE \\"
        echo "                     connect wss://${SERVER_HOST}:${SERVER_PORT}"
        echo ""
        warn "Note: CA certificate not available. Server verification will be disabled."
    fi
    echo ""
    echo "  2. Your certificate expires in $VALIDITY_DAYS days. Renew before expiration:"
    echo "     cryptic-onboard request"
    echo ""

    draw_box ""
}

#
# Command: info [cert_file]
# Display certificate information
#
cmd_info() {
    local cert_file="$1"

    draw_box "Certificate Information"
    echo ""

    # If no cert file specified, try to find one
    if [ -z "$cert_file" ]; then
        # Look for certificates in config directory (match username-based cert files)
        FOUND_CERTS=$(find "$CONFIG_DIR" -path "*/certificates/*.crt" -type f 2>/dev/null | grep -v "ca.crt")

        if [ -z "$FOUND_CERTS" ]; then
            error "No certificates found in $CONFIG_DIR\n\nRun 'cryptic-onboard request' to get a certificate."
        fi

        CERT_COUNT=$(echo "$FOUND_CERTS" | wc -l | tr -d ' ')

        if [ "$CERT_COUNT" -eq 1 ]; then
            cert_file=$(echo "$FOUND_CERTS" | head -1)
            info "Found certificate: $cert_file"
            echo ""
        else
            echo "Found $CERT_COUNT certificates:"
            echo "$FOUND_CERTS" | nl
            echo ""
            read -p "Select certificate number [1]: " cert_num
            cert_num=${cert_num:-1}
            cert_file=$(echo "$FOUND_CERTS" | sed -n "${cert_num}p")
        fi
    fi

    if [ ! -f "$cert_file" ]; then
        error "Certificate not found: $cert_file"
    fi

    # Extract server info from path if possible
    CERT_DIR=$(dirname $(dirname "$cert_file"))
    SERVER_INFO=$(basename "$CERT_DIR")

    if [[ "$SERVER_INFO" =~ ^(.+)_([0-9]+)$ ]]; then
        SERVER_HOST="${BASH_REMATCH[1]}"
        SERVER_PORT="${BASH_REMATCH[2]}"
        echo "Server:           ${SERVER_HOST}:${SERVER_PORT}"
    fi

    # Extract certificate details
    SUBJECT=$(openssl x509 -in "$cert_file" -noout -subject 2>/dev/null | sed 's/subject=//')
    ISSUER=$(openssl x509 -in "$cert_file" -noout -issuer 2>/dev/null | sed 's/issuer=//')
    SERIAL=$(openssl x509 -in "$cert_file" -noout -serial 2>/dev/null | sed 's/serial=//')
    NOT_BEFORE=$(openssl x509 -in "$cert_file" -noout -startdate 2>/dev/null | sed 's/notBefore=//')
    NOT_AFTER=$(openssl x509 -in "$cert_file" -noout -enddate 2>/dev/null | sed 's/notAfter=//')

    # Calculate remaining time
    if [[ "$OSTYPE" == "darwin"* ]]; then
        # macOS date command
        EXPIRES_TS=$(date -j -f "%b %d %T %Y %Z" "$NOT_AFTER" "+%s" 2>/dev/null || echo "0")
    else
        # Linux date command
        EXPIRES_TS=$(date -d "$NOT_AFTER" "+%s" 2>/dev/null || echo "0")
    fi

    NOW_TS=$(date "+%s")
    REMAINING_SEC=$((EXPIRES_TS - NOW_TS))

    if [ $REMAINING_SEC -gt 0 ]; then
        DAYS=$((REMAINING_SEC / 86400))
        HOURS=$(( (REMAINING_SEC % 86400) / 3600 ))
        REMAINING="${DAYS}d ${HOURS}h"

        if [ $DAYS -lt 2 ]; then
            warn "Certificate expires soon! Renew with: cryptic-onboard request"
            echo ""
        fi
    else
        REMAINING="EXPIRED"
        warn "Certificate has expired! Renew with: cryptic-onboard request"
        echo ""
    fi

    echo "Subject:          $SUBJECT"
    echo "Issuer:           $ISSUER"
    echo "Serial:           $SERIAL"
    echo ""
    echo "Validity:"
    echo "  Not Before:     $NOT_BEFORE"
    echo "  Not After:      $NOT_AFTER"
    echo "  Remaining:      $REMAINING"
    echo ""

    # Public key info
    PUBKEY_TYPE=$(openssl x509 -in "$cert_file" -noout -text 2>/dev/null | grep "Public Key Algorithm" | sed 's/.*: //')
    echo "Public Key:"
    echo "  Algorithm:      $PUBKEY_TYPE"

    if echo "$PUBKEY_TYPE" | grep -q "EC"; then
        CURVE=$(openssl x509 -in "$cert_file" -noout -text 2>/dev/null | grep "ASN1 OID" | sed 's/.*: //')
        echo "  Curve:          $CURVE"
    fi
    echo ""

    # File paths
    key_file="$(dirname $(dirname "$cert_file"))/private/client.key"

    echo "Files:"
    echo "  Certificate:    $cert_file"
    if [ -f "$key_file" ]; then
        echo "  Private Key:    $key_file"
    fi

    draw_box ""
}

#
# Interactive wizard
#
show_wizard() {
    clear
    draw_box "
   ╔═══════════════════════════════════════════════════════════════╗
   ║           Welcome to Cryptic Onboarding Wizard                ║
   ║                                                               ║
   ║  This wizard will guide you through the complete process      ║
   ║  of setting up your Cryptic secure messaging account.         ║
   ╚═══════════════════════════════════════════════════════════════╝
"

    echo ""
    echo "What would you like to do?"
    echo ""
    echo "  1) Generate a new GPG key pair"
    echo "  2) Export GPG public key for admin registration"
    echo "  3) Request a TLS certificate from server"
    echo "  4) Check certificate status and expiration"
    echo "  5) Complete onboarding walkthrough (steps 1-3)"
    echo "  6) Show help and documentation"
    echo "  0) Exit"
    echo ""
    read -p "Enter your choice [0-6]: " choice

    case "$choice" in
        1)
            clear
            draw_box "Generate New GPG Key Pair"
            echo ""
            info "This will create a new GPG key pair for use with Cryptic."
            echo ""
            generate_gpg_key
            echo ""
            success "GPG key generated successfully!"
            echo ""
            read -p "Press Enter to continue..."
            show_wizard
            ;;
        2)
            clear
            draw_box "Export GPG Public Key"
            echo ""
            cmd_export_gpg
            
            # If cancelled (no error, just returns), go back immediately
            if [ $? -eq 0 ]; then
                # Check if actually completed or just cancelled
                if [ -n "$GPG_FP" ]; then
                    echo ""
                    info "Next steps:"
                    echo "  1. Send the exported file to your Cryptic administrator"
                    echo "  2. Wait for admin confirmation that your key is registered"
                    echo "  3. Come back and select option 3 to request a certificate"
                    echo ""
                    read -p "Press Enter to continue..."
                fi
            fi
            show_wizard
            ;;
        3)
            clear
            draw_box "Request TLS Certificate"
            echo ""
            read -p "Server hostname [localhost]: " server_host
            server_host=${server_host:-localhost}

            read -p "Server port [8443]: " server_port
            server_port=${server_port:-8443}

            server_url="https://${server_host}:${server_port}"
            echo ""
            cmd_request "$server_url"
            echo ""
            read -p "Press Enter to continue..."
            show_wizard
            ;;
        4)
            clear
            draw_box "Certificate Status"
            echo ""
            cmd_info
            echo ""
            read -p "Press Enter to continue..."
            show_wizard
            ;;
        5)
            clear
            draw_box "Complete Onboarding Walkthrough"
            echo ""
            info "This will guide you through the complete onboarding process."
            echo ""

            # Step 1: Check for GPG key
            info "Step 1/3: Checking for GPG key..."
            echo ""

            gpg_keys=$(gpg --list-secret-keys --keyid-format LONG 2>/dev/null | grep -c "^sec" || true)

            if [ "$gpg_keys" -eq 0 ]; then
                warn "No GPG key found. Let's generate one."
                echo ""
                generate_gpg_key
                echo ""
                success "GPG key generated!"
            else
                success "Found existing GPG key(s)"
            fi
            echo ""
            read -p "Press Enter to continue to step 2..."

            # Step 2: Export GPG key
            clear
            draw_box "Complete Onboarding Walkthrough - Step 2/3"
            echo ""
            info "Step 2/3: Exporting GPG public key for admin..."
            echo ""

            cmd_export_gpg

            echo ""
            warn "IMPORTANT: Before proceeding to step 3:"
            echo "  1. Send the exported GPG public key file to your administrator"
            echo "  2. Wait for confirmation that your key has been registered"
            echo "  3. This usually takes a few minutes"
            echo ""
            read -p "Press Enter when admin has confirmed registration..."

            # Step 3: Request certificate
            clear
            draw_box "Complete Onboarding Walkthrough - Step 3/3"
            echo ""
            info "Step 3/3: Requesting TLS certificate..."
            echo ""

            read -p "Server hostname [localhost]: " server_host
            server_host=${server_host:-localhost}

            read -p "Server port [8443]: " server_port
            server_port=${server_port:-8443}

            server_url="https://${server_host}:${server_port}"
            echo ""

            cmd_request "$server_url"

            echo ""
            draw_box ""
            success "Onboarding complete! You're ready to connect to Cryptic!"
            echo ""
            info "To connect, use:"
            echo "  cryptic-console connect wss://<server>:8443"
            echo ""
            read -p "Press Enter to return to main menu..."
            show_wizard
            ;;
        6)
            clear
            show_help
            echo ""
            read -p "Press Enter to return to main menu..."
            show_wizard
            ;;
        0)
            echo ""
            info "Thanks for using Cryptic! Goodbye."
            echo ""
            exit 0
            ;;
        *)
            warn "Invalid choice. Please try again."
            sleep 2
            show_wizard
            ;;
    esac
}

show_help() {
    cat <<EOF
Usage: cryptic-onboard [command] [options]

Interactive Mode:
  cryptic-onboard                   Launch interactive wizard (recommended)

Direct Commands:
  generate-gpg                      Generate new GPG key pair
  export-gpg                        Export GPG public key for admin registration
  request [server_url]              Request TLS certificate from CA
  info [cert_file]                  Display certificate information
  help                              Show this help message

Admin Commands (for mobile enrollment):
  create-enrollment                 Create enrollment package for mobile users
    --username, -u <user>             Username for mobile user (required)
    --server, -s <host>               Server hostname (required)
    --port, -p <port>                 Server port (default: 8443)
    --passphrase <pass>               Enrollment passphrase (will prompt if not provided)
    --output, -o <file>               Output QR code file (default: <username>_enrollment.png)
    --ca-cert <file>                  Path to server CA certificate (optional)
    --batch                           Non-interactive mode (requires all options)

  Examples:
    # Interactive mode
    cryptic-onboard create-enrollment

    # Batch mode
    cryptic-onboard create-enrollment \
      --username alice \
      --server cryptic.example.com \
      --passphrase "correct-horse-battery-staple" \
      --ca-cert /path/to/ca.crt \
      --batch

Admin-Mediated Onboarding Flow:
  1. Generate or select your GPG key:
       cryptic-onboard generate-gpg

  2. Export your GPG public key:
       cryptic-onboard export-gpg

  3. Send the exported GPG public key to your Cryptic administrator

  4. Once the admin registers your GPG key, request a certificate:
       cryptic-onboard request [server_url]

  5. Connect to Cryptic:
       cryptic_console -u <username>

Certificate Renewal:
  Certificates are valid for 7 days. Renew before expiration:
       cryptic-onboard request

  Check certificate expiration:
       cryptic-onboard info

Examples:
  # Interactive wizard (recommended for first-time users)
  cryptic-onboard

  # Generate new GPG key
  cryptic-onboard generate-gpg

  # Export GPG public key
  cryptic-onboard export-gpg

  # Request certificate after admin registration
  cryptic-onboard request https://relay.cryptic.example.org:8443

  # Show certificate info
  cryptic-onboard info

Dependencies: curl, openssl, gpg, jq

EOF
}

#
# Main command dispatcher
#
main() {
    check_dependencies

    local command="$1"
    shift || true  # Don't exit on error if no args

    case "$command" in
        generate-gpg|generate)
            generate_gpg_key
            ;;
        create-enrollment)
            cmd_create_enrollment "$@"
            ;;
        create-mobile-enrollment)
            cmd_create_mobile_enrollment "$@"
            ;;
        export-gpg|export)
            cmd_export_gpg "$@"
            ;;
        request)
            cmd_request "$@"
            ;;
        info)
            cmd_info "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        "")
            # No command = interactive wizard
            show_wizard
            ;;
        *)
            error "Unknown command: $command\n\nUse 'cryptic-onboard help' for usage information."
            ;;
    esac
}

main "$@"
