#!/bin/bash
#
# cryptic-onboard - Interactive onboarding wizard for Cryptic
#
# This script provides an interactive wizard-style interface for the complete
# Cryptic onboarding process, from GPG key generation to certificate requests.
#
# Usage:
#   cryptic-onboard                         Interactive wizard (recommended)
#   cryptic-onboard export-gpg              Export GPG public key for admin
#   cryptic-onboard request [server_url]    Request certificate from CA
#   cryptic-onboard info [cert_file]        Display certificate information
#   cryptic-onboard generate-gpg            Generate new GPG key pair
#
# Dependencies: curl, openssl, gpg, jq
#
# Author: Cryptic Team
# Date: 2025-11-04

set -e  # Exit on error

# Configuration
CONFIG_DIR="${HOME}/.cryptic"
CONFIG_FILE="${CONFIG_DIR}/config.json"
DEFAULT_SERVER="https://relay.cryptic.example.org:8443"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
error() {
    echo -e "${RED}Error: $1${NC}" >&2
    exit 1
}

success() {
    echo -e "${GREEN}✓ $1${NC}"
}

info() {
    echo -e "${BLUE}$1${NC}"
}

warn() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

check_dependencies() {
    local missing_deps=()

    for cmd in curl openssl gpg jq; do
        if ! command -v "$cmd" &> /dev/null; then
            missing_deps+=("$cmd")
        fi
    done

    if [ ${#missing_deps[@]} -gt 0 ]; then
        error "Missing required dependencies: ${missing_deps[*]}\nPlease install them and try again."
    fi
}

parse_server_url() {
    local url="$1"

    # Extract host
    SERVER_HOST=$(echo "$url" | sed -E 's|^https?://([^:/]+).*|\1|')

    # Extract port (default to 8443 if not specified)
    SERVER_PORT=$(echo "$url" | sed -E 's|^https?://[^:]+:([0-9]+).*|\1|')
    if [ -z "$SERVER_PORT" ] || [ "$SERVER_PORT" = "$url" ]; then
        SERVER_PORT="8443"
    fi

    if [ -z "$SERVER_HOST" ]; then
        error "Invalid server URL: $url"
    fi
}

draw_box() {
    local text="$1"
    local width=70
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    if [ -n "$text" ]; then
        echo "$text"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    fi
}

generate_gpg_key() {
    info "Generating new GPG key..."
    echo ""
    echo "Please provide the following information:"
    echo ""
    
    read -p "Real name: " real_name
    if [ -z "$real_name" ]; then
        error "Real name is required"
    fi
    
    read -p "Email address: " email_addr
    if [ -z "$email_addr" ]; then
        error "Email address is required"
    fi
    
    read -p "Comment (optional): " comment
    
    echo ""
    info "Generating GPG key for: $real_name <$email_addr>"
    info "This may take a minute..."
    echo ""
    
    # Generate key using batch mode for automation
    # Using RSA 4096 as it's widely supported
    gpg --batch --gen-key <<EOF
%no-protection
Key-Type: RSA
Key-Length: 4096
Subkey-Type: RSA
Subkey-Length: 4096
Name-Real: $real_name
Name-Email: $email_addr
Name-Comment: $comment
Expire-Date: 2y
%commit
EOF
    
    if [ $? -eq 0 ]; then
        success "GPG key generated successfully!"
        echo ""
        info "Your new GPG key:"
        gpg --list-keys "$email_addr" 2>/dev/null | head -4
        echo ""
        # Set global variable for the caller to use
        GENERATED_GPG_EMAIL="$email_addr"
    else
        error "Failed to generate GPG key"
    fi
}

select_gpg_key() {
    # Get list of GPG keys with fingerprints
    # Format: fingerprint|uid
    GPG_KEYS_RAW=$(gpg --list-secret-keys --with-colons 2>/dev/null | \
                   awk -F: '
                   /^sec/ {fpr=""} 
                   /^fpr/ {fpr=$10} 
                   /^uid/ && fpr!="" {print fpr "|" $10; fpr=""}
                   ' | head -10)

    if [ -z "$GPG_KEYS_RAW" ]; then
        warn "No GPG keys found."
        echo ""
        read -p "Would you like to generate a new GPG key? [Y/n]: " gen_key
        gen_key=${gen_key:-Y}
        if [ "$gen_key" = "Y" ] || [ "$gen_key" = "y" ]; then
            generate_gpg_key
            # Use the email from the generated key
            SELECTED_GPG_EMAIL="$GENERATED_GPG_EMAIL"
            if [ -z "$SELECTED_GPG_EMAIL" ]; then
                error "GPG key generation failed or was cancelled"
            fi
            # Get fingerprint for the generated key
            SELECTED_GPG_FP=$(gpg --with-colons --fingerprint "$SELECTED_GPG_EMAIL" 2>/dev/null | \
                             grep "^fpr" | head -1 | cut -d: -f10)
        else
            error "Cannot proceed without a GPG key. Please generate one manually:\n  gpg --full-generate-key"
        fi
        return
    fi

    # Always present a choice menu, even for single key
    KEY_COUNT=$(echo "$GPG_KEYS_RAW" | wc -l | tr -d ' ')
    
    echo "Available GPG keys:"
    echo ""
    local i=1
    while IFS='|' read -r fp uid; do
        echo "  $i) $uid"
        echo "     Fingerprint: $fp"
        echo ""
        i=$((i + 1))
    done <<< "$GPG_KEYS_RAW"
    echo "  $i) Generate new GPG key"
    echo ""
    read -p "Select key number [1]: " key_num
    key_num=${key_num:-1}
    
    if [ "$key_num" -eq "$i" ]; then
        generate_gpg_key
        SELECTED_GPG_EMAIL="$GENERATED_GPG_EMAIL"
        SELECTED_GPG_FP=$(gpg --with-colons --fingerprint "$SELECTED_GPG_EMAIL" 2>/dev/null | \
                         grep "^fpr" | head -1 | cut -d: -f10)
    elif [ "$key_num" -ge 1 ] && [ "$key_num" -lt "$i" ]; then
        SELECTED_GPG_FP=$(echo "$GPG_KEYS_RAW" | sed -n "${key_num}p" | cut -d'|' -f1)
        SELECTED_GPG_UID=$(echo "$GPG_KEYS_RAW" | sed -n "${key_num}p" | cut -d'|' -f2)
        # Extract email from UID
        SELECTED_GPG_EMAIL=$(echo "$SELECTED_GPG_UID" | grep -oE '[^<]+@[^>]+' | head -1)
        if [ -z "$SELECTED_GPG_EMAIL" ]; then
            SELECTED_GPG_EMAIL="$SELECTED_GPG_UID"
        fi
    else
        error "Invalid selection: $key_num"
    fi
}

#
# Command: export-gpg
# Export GPG public key for admin registration
#
cmd_export_gpg() {
    draw_box "Cryptic Onboarding - Step 1: Export GPG Public Key"
    echo ""
    
    info "This command helps you export your GPG public key so an admin"
    info "can register you in the Cryptic system."
    echo ""
    
    # Step 1: Select GPG key
    select_gpg_key
    
    if [ -z "$SELECTED_GPG_FP" ]; then
        error "No GPG key selected"
    fi
    
    GPG_FP="$SELECTED_GPG_FP"
    GPG_EMAIL="$SELECTED_GPG_EMAIL"
    
    echo ""
    success "Selected GPG key:"
    echo "  UID:         $GPG_EMAIL"
    echo "  Fingerprint: $GPG_FP"
    echo ""
    
    # Step 2: Export public key
    info "Exporting GPG public key..."
    GPG_PUBKEY=$(gpg --armor --export "$GPG_FP" 2>/dev/null)
    if [ -z "$GPG_PUBKEY" ]; then
        error "Failed to export GPG public key"
    fi
    
    # Save to file
    OUTPUT_DIR="${CONFIG_DIR}/gpg-export"
    mkdir -p "$OUTPUT_DIR"
    OUTPUT_FILE="${OUTPUT_DIR}/gpg-public-${GPG_FP}.asc"
    
    echo "$GPG_PUBKEY" > "$OUTPUT_FILE"
    success "GPG public key exported to: $OUTPUT_FILE"
    echo ""
    
    # Save config for later use
    mkdir -p "$CONFIG_DIR"
    jq -n \
        --arg fp "$GPG_FP" \
        --arg email "$SELECTED_GPG_EMAIL" \
        '{gpg_fingerprint: $fp, gpg_email: $email}' \
        > "$CONFIG_FILE"
    
    draw_box ""
    echo ""
    info "Next steps:"
    echo ""
    echo "  1. Send your GPG public key to a Cryptic administrator:"
    echo "     File: $OUTPUT_FILE"
    echo ""
    echo "  2. Include this information in your request:"
    echo "     - Your full name"
    echo "     - Your team/department"
    echo "     - GPG Fingerprint: $GPG_FP"
    echo ""
    echo "  3. Once the admin registers your GPG key, run:"
    echo "     cryptic-onboard request [server_url]"
    echo ""
    
    draw_box ""
}

#
# Command: request [server_url]
# Requests TLS certificate from CA (admin must have registered your GPG key first)
#
cmd_request() {
    local server_url="$1"

    draw_box "Cryptic Onboarding - Step 2: Request Certificate"
    echo ""

    # Load config
    if [ ! -f "$CONFIG_FILE" ]; then
        warn "No configuration found. Run 'cryptic-onboard export-gpg' first."
        echo ""
        info "Continuing without saved configuration..."
        select_gpg_key
        
        if [ -z "$SELECTED_GPG_FP" ]; then
            error "No GPG key selected"
        fi
        
        GPG_FP="$SELECTED_GPG_FP"
        GPG_EMAIL="$SELECTED_GPG_EMAIL"
        
        echo ""
        success "Selected GPG key:"
        echo "  UID:         $GPG_EMAIL"
        echo "  Fingerprint: $GPG_FP"
    else
        GPG_FP=$(jq -r '.gpg_fingerprint // empty' "$CONFIG_FILE")
        GPG_EMAIL=$(jq -r '.gpg_email // empty' "$CONFIG_FILE")

        if [ -z "$GPG_FP" ] || [ -z "$GPG_EMAIL" ]; then
            error "Invalid config file. Please run 'cryptic-onboard export-gpg' again."
        fi
        
        echo ""
        info "Using GPG key from config:"
        echo "  UID:         $GPG_EMAIL"
        echo "  Fingerprint: $GPG_FP"
    fi

    # Use provided server or default
    if [ -z "$server_url" ]; then
        if [ -f "$CONFIG_FILE" ]; then
            server_url=$(jq -r '.default_server // empty' "$CONFIG_FILE")
        fi
        if [ -z "$server_url" ]; then
            read -p "CA server URL [$DEFAULT_SERVER]: " server_url
            server_url=${server_url:-$DEFAULT_SERVER}
        fi
    fi

    parse_server_url "$server_url"
    
    echo ""
    info "Server: ${SERVER_HOST}:${SERVER_PORT}"
    echo ""

    # Create directory structure
    CERT_DIR="${CONFIG_DIR}/${SERVER_HOST}_${SERVER_PORT}"
    CERT_SUBDIR="${CERT_DIR}/certificates"
    KEY_SUBDIR="${CERT_DIR}/private"
    mkdir -p "$CERT_SUBDIR" "$KEY_SUBDIR"

    KEY_FILE="${KEY_SUBDIR}/client.key"
    CSR_FILE="${CERT_DIR}/client.csr"
    CERT_FILE="${CERT_SUBDIR}/client.pem"

    # Step 1: Generate TLS key pair
    info "[1/4] Generating TLS key pair (ECDSA secp384r1)..."
    if [ ! -f "$KEY_FILE" ]; then
        openssl ecparam -genkey -name secp384r1 -out "$KEY_FILE" 2>/dev/null
        chmod 600 "$KEY_FILE"
        success "TLS key pair generated"
    else
        success "Using existing TLS key"
    fi

    # Step 2: Create CSR with GPG fingerprint in CN
    info "[2/4] Creating Certificate Signing Request (CSR)..."
    openssl req -new -key "$KEY_FILE" \
        -subj "/CN=${GPG_FP}.gpg.cryptic.local" \
        -out "$CSR_FILE" 2>/dev/null
    success "CSR created"

    # Step 3: Sign CSR with GPG key
    info "[3/4] Signing CSR with GPG key (fingerprint: ${GPG_FP:0:16}...)..."
    # Read CSR data - preserve exact bytes including any trailing newline
    CSR_DATA=$(cat "$CSR_FILE"; echo x)
    CSR_DATA=${CSR_DATA%x}
    # Use fingerprint with ! suffix to force exact key match
    # Sign the exact CSR data we're going to send
    GPG_SIG=$(printf '%s' "$CSR_DATA" | gpg --armor --detach-sign --local-user "${GPG_FP}!" 2>/dev/null)
    if [ $? -ne 0 ]; then
        echo ""
        error "Failed to sign CSR with GPG key.\n\nFingerprint: $GPG_FP\nUID: $GPG_EMAIL\n\nMake sure you have the private key and it's not expired."
    fi
    success "CSR signed with GPG"

    # Step 4: Submit to CA
    info "[4/4] Submitting to CA..."
    CA_REST_URL="https://${SERVER_HOST}:${SERVER_PORT}"

    # Create JSON payload
    GPG_SIG_B64=$(printf '%s' "$GPG_SIG" | base64 | tr -d '\n')
    JSON_PAYLOAD=$(jq -n \
        --arg csr "$CSR_DATA" \
        --arg fp "$GPG_FP" \
        --arg sig "$GPG_SIG_B64" \
        '{csr_pem: $csr, gpg_fp: $fp, gpg_sig_b64: $sig}')

    # Make API call
    # Note: Using -k for self-signed certificates in development
    # In production, you should use --cacert with the CA certificate
    RESPONSE=$(curl -k -s -w "\n%{http_code}" -X POST "${CA_REST_URL}/ca/v1/csr" \
        -H "Content-Type: application/json" \
        -d "$JSON_PAYLOAD" 2>/dev/null || echo "000")

    HTTP_CODE=$(echo "$RESPONSE" | tail -1)
    BODY=$(echo "$RESPONSE" | sed '$d')

    if [ "$HTTP_CODE" != "200" ]; then
        echo ""
        error "Certificate request failed (HTTP $HTTP_CODE)\n\nResponse: $BODY\n\nPossible reasons:\n  - Admin has not registered your GPG key yet\n  - Your account has been suspended or revoked\n  - Network/server issue\n\nPlease contact your Cryptic administrator."
    fi

    # Save certificate
    CERT_PEM=$(echo "$BODY" | jq -r '.cert_pem // empty')
    if [ -z "$CERT_PEM" ]; then
        error "No certificate in response"
    fi

    echo "$CERT_PEM" > "$CERT_FILE"
    success "Certificate issued successfully!"
    echo ""

    # Parse certificate info
    SERIAL=$(openssl x509 -in "$CERT_FILE" -noout -serial 2>/dev/null | cut -d= -f2)
    SUBJECT=$(openssl x509 -in "$CERT_FILE" -noout -subject 2>/dev/null | cut -d= -f2-)
    NOT_BEFORE=$(openssl x509 -in "$CERT_FILE" -noout -startdate 2>/dev/null | cut -d= -f2)
    NOT_AFTER=$(openssl x509 -in "$CERT_FILE" -noout -enddate 2>/dev/null | cut -d= -f2)
    EXPIRES_AT=$(echo "$BODY" | jq -r '.expires_at // empty')
    VALIDITY_DAYS=$(echo "$BODY" | jq -r '.validity_days // 7')

    echo "Certificate Details:"
    echo "  Serial:        $SERIAL"
    echo "  Subject:       $SUBJECT"
    echo "  Issuer:        CN=Cryptic CA"
    echo "  Valid From:    $NOT_BEFORE"
    echo "  Valid Until:   $NOT_AFTER"
    echo "  Validity:      $VALIDITY_DAYS days"
    echo ""
    echo "Files:"
    echo "  Certificate:   $CERT_FILE"
    echo "  Private Key:   $KEY_FILE"
    echo ""
    echo "Directory structure:"
    echo "  ${CERT_DIR}/"
    echo "    ├── certificates/"
    echo "    │   └── client.pem"
    echo "    ├── private/"
    echo "    │   └── client.key"
    echo "    └── client.csr"
    echo ""
    
    # Save server URL to config for future use
    if [ -f "$CONFIG_FILE" ]; then
        # Update existing config
        TEMP_FILE="${CONFIG_FILE}.tmp"
        jq --arg server "$server_url" '.default_server = $server' "$CONFIG_FILE" > "$TEMP_FILE"
        mv "$TEMP_FILE" "$CONFIG_FILE"
    else
        # Create new config
        mkdir -p "$CONFIG_DIR"
        jq -n \
            --arg fp "$GPG_FP" \
            --arg email "$GPG_EMAIL" \
            --arg server "$server_url" \
            '{gpg_fingerprint: $fp, gpg_email: $email, default_server: $server}' \
            > "$CONFIG_FILE"
    fi
    
    draw_box ""
    echo ""
    info "Next steps:"
    echo ""
    echo "  1. Connect to Cryptic using your certificate:"
    echo "     cryptic-console --cert $CERT_FILE \\"
    echo "                     --key $KEY_FILE \\"
    echo "                     connect wss://${SERVER_HOST}:${SERVER_PORT}"
    echo ""
    echo "  2. Your certificate expires in $VALIDITY_DAYS days. Renew before expiration:"
    echo "     cryptic-onboard request"
    echo ""
    
    draw_box ""
}

#
# Command: info [cert_file]
# Display certificate information
#
cmd_info() {
    local cert_file="$1"

    draw_box "Certificate Information"
    echo ""

    # If no cert file specified, try to find one
    if [ -z "$cert_file" ]; then
        # Look for certificates in config directory
        FOUND_CERTS=$(find "$CONFIG_DIR" -name "client.pem" -type f 2>/dev/null)
        
        if [ -z "$FOUND_CERTS" ]; then
            error "No certificates found in $CONFIG_DIR\n\nRun 'cryptic-onboard request' to get a certificate."
        fi
        
        CERT_COUNT=$(echo "$FOUND_CERTS" | wc -l | tr -d ' ')
        
        if [ "$CERT_COUNT" -eq 1 ]; then
            cert_file=$(echo "$FOUND_CERTS" | head -1)
            info "Found certificate: $cert_file"
            echo ""
        else
            echo "Found $CERT_COUNT certificates:"
            echo "$FOUND_CERTS" | nl
            echo ""
            read -p "Select certificate number [1]: " cert_num
            cert_num=${cert_num:-1}
            cert_file=$(echo "$FOUND_CERTS" | sed -n "${cert_num}p")
        fi
    fi

    if [ ! -f "$cert_file" ]; then
        error "Certificate not found: $cert_file"
    fi

    # Extract server info from path if possible
    CERT_DIR=$(dirname $(dirname "$cert_file"))
    SERVER_INFO=$(basename "$CERT_DIR")
    
    if [[ "$SERVER_INFO" =~ ^(.+)_([0-9]+)$ ]]; then
        SERVER_HOST="${BASH_REMATCH[1]}"
        SERVER_PORT="${BASH_REMATCH[2]}"
        echo "Server:           ${SERVER_HOST}:${SERVER_PORT}"
    fi

    # Extract certificate details
    SUBJECT=$(openssl x509 -in "$cert_file" -noout -subject 2>/dev/null | sed 's/subject=//')
    ISSUER=$(openssl x509 -in "$cert_file" -noout -issuer 2>/dev/null | sed 's/issuer=//')
    SERIAL=$(openssl x509 -in "$cert_file" -noout -serial 2>/dev/null | sed 's/serial=//')
    NOT_BEFORE=$(openssl x509 -in "$cert_file" -noout -startdate 2>/dev/null | sed 's/notBefore=//')
    NOT_AFTER=$(openssl x509 -in "$cert_file" -noout -enddate 2>/dev/null | sed 's/notAfter=//')

    # Calculate remaining time
    if [[ "$OSTYPE" == "darwin"* ]]; then
        # macOS date command
        EXPIRES_TS=$(date -j -f "%b %d %T %Y %Z" "$NOT_AFTER" "+%s" 2>/dev/null || echo "0")
    else
        # Linux date command
        EXPIRES_TS=$(date -d "$NOT_AFTER" "+%s" 2>/dev/null || echo "0")
    fi
    
    NOW_TS=$(date "+%s")
    REMAINING_SEC=$((EXPIRES_TS - NOW_TS))

    if [ $REMAINING_SEC -gt 0 ]; then
        DAYS=$((REMAINING_SEC / 86400))
        HOURS=$(( (REMAINING_SEC % 86400) / 3600 ))
        REMAINING="${DAYS}d ${HOURS}h"
        
        if [ $DAYS -lt 2 ]; then
            warn "Certificate expires soon! Renew with: cryptic-onboard request"
            echo ""
        fi
    else
        REMAINING="EXPIRED"
        warn "Certificate has expired! Renew with: cryptic-onboard request"
        echo ""
    fi

    echo "Subject:          $SUBJECT"
    echo "Issuer:           $ISSUER"
    echo "Serial:           $SERIAL"
    echo ""
    echo "Validity:"
    echo "  Not Before:     $NOT_BEFORE"
    echo "  Not After:      $NOT_AFTER"
    echo "  Remaining:      $REMAINING"
    echo ""

    # Public key info
    PUBKEY_TYPE=$(openssl x509 -in "$cert_file" -noout -text 2>/dev/null | grep "Public Key Algorithm" | sed 's/.*: //')
    echo "Public Key:"
    echo "  Algorithm:      $PUBKEY_TYPE"

    if echo "$PUBKEY_TYPE" | grep -q "EC"; then
        CURVE=$(openssl x509 -in "$cert_file" -noout -text 2>/dev/null | grep "ASN1 OID" | sed 's/.*: //')
        echo "  Curve:          $CURVE"
    fi
    echo ""

    # File paths
    key_file="$(dirname $(dirname "$cert_file"))/private/client.key"

    echo "Files:"
    echo "  Certificate:    $cert_file"
    if [ -f "$key_file" ]; then
        echo "  Private Key:    $key_file"
    fi

    draw_box ""
}

#
# Interactive wizard
#
show_wizard() {
    clear
    draw_box "
   ╔═══════════════════════════════════════════════════════════════╗
   ║           Welcome to Cryptic Onboarding Wizard                ║
   ║                                                               ║
   ║  This wizard will guide you through the complete process      ║
   ║  of setting up your Cryptic secure messaging account.         ║
   ╚═══════════════════════════════════════════════════════════════╝
"
    
    echo ""
    echo "What would you like to do?"
    echo ""
    echo "  1) Generate a new GPG key pair"
    echo "  2) Export GPG public key for admin registration"
    echo "  3) Request a TLS certificate from server"
    echo "  4) Check certificate status and expiration"
    echo "  5) Complete onboarding walkthrough (steps 1-3)"
    echo "  6) Show help and documentation"
    echo "  0) Exit"
    echo ""
    read -p "Enter your choice [0-6]: " choice
    
    case "$choice" in
        1)
            clear
            draw_box "Generate New GPG Key Pair"
            echo ""
            info "This will create a new GPG key pair for use with Cryptic."
            echo ""
            generate_gpg_key
            echo ""
            success "GPG key generated successfully!"
            echo ""
            read -p "Press Enter to continue..."
            show_wizard
            ;;
        2)
            clear
            draw_box "Export GPG Public Key"
            echo ""
            cmd_export_gpg
            echo ""
            info "Next steps:"
            echo "  1. Send the exported file to your Cryptic administrator"
            echo "  2. Wait for admin confirmation that your key is registered"
            echo "  3. Come back and select option 3 to request a certificate"
            echo ""
            read -p "Press Enter to continue..."
            show_wizard
            ;;
        3)
            clear
            draw_box "Request TLS Certificate"
            echo ""
            read -p "Enter server URL (or press Enter for default): " server_url
            if [ -z "$server_url" ]; then
                server_url="$DEFAULT_SERVER"
            fi
            echo ""
            cmd_request "$server_url"
            echo ""
            read -p "Press Enter to continue..."
            show_wizard
            ;;
        4)
            clear
            draw_box "Certificate Status"
            echo ""
            cmd_info
            echo ""
            read -p "Press Enter to continue..."
            show_wizard
            ;;
        5)
            clear
            draw_box "Complete Onboarding Walkthrough"
            echo ""
            info "This will guide you through the complete onboarding process."
            echo ""
            
            # Step 1: Check for GPG key
            info "Step 1/3: Checking for GPG key..."
            echo ""
            
            gpg_keys=$(gpg --list-secret-keys --keyid-format LONG 2>/dev/null | grep -c "^sec" || true)
            
            if [ "$gpg_keys" -eq 0 ]; then
                warn "No GPG key found. Let's generate one."
                echo ""
                generate_gpg_key
                echo ""
                success "GPG key generated!"
            else
                success "Found existing GPG key(s)"
            fi
            echo ""
            read -p "Press Enter to continue to step 2..."
            
            # Step 2: Export GPG key
            clear
            draw_box "Complete Onboarding Walkthrough - Step 2/3"
            echo ""
            info "Step 2/3: Exporting GPG public key for admin..."
            echo ""
            
            cmd_export_gpg
            
            echo ""
            warn "IMPORTANT: Before proceeding to step 3:"
            echo "  1. Send the exported GPG public key file to your administrator"
            echo "  2. Wait for confirmation that your key has been registered"
            echo "  3. This usually takes a few minutes"
            echo ""
            read -p "Press Enter when admin has confirmed registration..."
            
            # Step 3: Request certificate
            clear
            draw_box "Complete Onboarding Walkthrough - Step 3/3"
            echo ""
            info "Step 3/3: Requesting TLS certificate..."
            echo ""
            
            read -p "Enter server URL (or press Enter for default): " server_url
            if [ -z "$server_url" ]; then
                server_url="$DEFAULT_SERVER"
            fi
            echo ""
            
            cmd_request "$server_url"
            
            echo ""
            draw_box ""
            success "Onboarding complete! You're ready to connect to Cryptic!"
            echo ""
            info "To connect, use:"
            echo "  cryptic-console connect wss://<server>:8443"
            echo ""
            read -p "Press Enter to return to main menu..."
            show_wizard
            ;;
        6)
            clear
            show_help
            echo ""
            read -p "Press Enter to return to main menu..."
            show_wizard
            ;;
        0)
            echo ""
            info "Thanks for using Cryptic! Goodbye."
            echo ""
            exit 0
            ;;
        *)
            warn "Invalid choice. Please try again."
            sleep 2
            show_wizard
            ;;
    esac
}

show_help() {
    cat <<EOF
Usage: cryptic-onboard [command] [options]

Interactive Mode:
  cryptic-onboard                   Launch interactive wizard (recommended)

Direct Commands:
  generate-gpg                      Generate new GPG key pair
  export-gpg                        Export GPG public key for admin registration
  request [server_url]              Request TLS certificate from CA
  info [cert_file]                  Display certificate information
  help                              Show this help message

Admin-Mediated Onboarding Flow:
  1. Generate or select your GPG key:
       cryptic-onboard generate-gpg

  2. Export your GPG public key:
       cryptic-onboard export-gpg

  3. Send the exported GPG public key to your Cryptic administrator

  4. Once the admin registers your GPG key, request a certificate:
       cryptic-onboard request [server_url]

  5. Connect to Cryptic:
       cryptic-console connect wss://server:8443

Certificate Renewal:
  Certificates are valid for 7 days. Renew before expiration:
       cryptic-onboard request

  Check certificate expiration:
       cryptic-onboard info

Examples:
  # Interactive wizard (recommended for first-time users)
  cryptic-onboard

  # Generate new GPG key
  cryptic-onboard generate-gpg

  # Export GPG public key
  cryptic-onboard export-gpg

  # Request certificate after admin registration
  cryptic-onboard request https://relay.cryptic.example.org:8443

  # Show certificate info
  cryptic-onboard info

Dependencies: curl, openssl, gpg, jq

EOF
}

#
# Main command dispatcher
#
main() {
    check_dependencies

    local command="$1"
    shift || true  # Don't exit on error if no args

    case "$command" in
        generate-gpg|generate)
            generate_gpg_key
            ;;
        export-gpg|export)
            cmd_export_gpg "$@"
            ;;
        request)
            cmd_request "$@"
            ;;
        info)
            cmd_info "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        "")
            # No command = interactive wizard
            show_wizard
            ;;
        *)
            error "Unknown command: $command\n\nUse 'cryptic-onboard help' for usage information."
            ;;
    esac
}

main "$@"
