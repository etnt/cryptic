{application, cryptic, [
    {description, "Minimal End-to-End Encrypted Chat"},
    {vsn, "0.1.0"},
    {registered, []},
    {applications, [
        kernel,
        stdlib,
        asn1,
        public_key,
        ssl,
        crypto,
        ranch,
        cowlib,
        cowboy,
        eclip,
        uuid
    ]},
    {mod, {cryptic_app, []}},
    {env, [
        %% Event handling configuration
        {cryptic_event_handlers, [cryptic_file_logger]},

        % WebSocket mTLS server configuration
        {websocket_mtls_enabled, true},
        {websocket_mtls_port, 8443},

        % Poll interval (seconds)

        % FIXME: adjust as needed
        {poll_interval, 2},

        % Enable debug output
        {enable_debug, false}
    ]}
]}.
