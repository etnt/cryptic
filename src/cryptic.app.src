{application, cryptic, [
    {description, "Minimal End-to-End Encrypted Chat"},
    {vsn, "1.0.0"},
    {registered, []},
    {applications, [
        kernel,
        stdlib,
        asn1,
        public_key,
        ssl,
        crypto,
        ranch,
        cowlib,
        cowboy,
        esqlite,
        uuid,
        erl_gpg
    ]},
    {mod, {cryptic_app, []}},
    {env, [
        %% Event handling configuration
        {cryptic_event_handlers, [cryptic_file_logger]},

        % WebSocket mTLS server configuration
        {websocket_mtls_enabled, true},
        {websocket_mtls_port, 8443},

        % Poll interval (seconds)

        % FIXME: adjust as needed
        {poll_interval, 2},

        % Enable debug output
        {enable_debug, false},

        %% CA Certificate Files (generated by myca)
        {ca_cert_file, "priv/ssl/ca.crt"},
        {ca_key_file, "priv/ssl/ca.key"},

        %% Server Certificate Files (for mTLS)
        {server_cert_file, "priv/ssl/server.crt"},
        {server_key_file, "priv/ssl/server.key"},

        %% Database Configuration
        {ca_db_file, "data/ca/cryptic_ca.db"},
        {storage_backend, esqlite},

        %% Certificate Policy
        {cert_default_lifetime_days, 7},
        {cert_max_lifetime_days, 30},
        {cert_renewal_threshold, 0.5},

        %% Invite Policy
        {invite_default_ttl_hours, 24},
        {invite_max_ttl_hours, 72},

        %% Audit Configuration
        {audit_enabled, true},
        {audit_retention_days, 90}
    ]}
]}.
