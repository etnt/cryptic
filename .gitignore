# Compiled files
_build/
*.beam
*.o
*.so
erl_crash.dump

# NIF compiled artifacts (architecture specific)
c_src/*.o
priv/*.so

# Documentation (generated by rebar3 edoc)
doc/*.html
doc/*.css
doc/*.png
doc/edoc-info
doc/modules-frame.html
!doc/overview.edoc

# Logs
logs/
*.log

# Operating System files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Temporary files
*.tmp
*.temp

# Certificate private keys (keep public certs for examples)
CA/private/*.key
CA/private/*.pem
!CA/private/.gitkeep

# Test artifacts
.eunit/
test/ebin/

# Rebar3 cache
.rebar3/
