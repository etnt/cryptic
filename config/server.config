[
 {cryptic_server, [
   %% Server configuration
   {server_port, 8080},
   {server_https_port, 8443},
   
   %% SSL/TLS configuration for mTLS
   {ssl_options, [
     {certfile, "priv/ssl/server.crt"},
     {keyfile, "priv/ssl/server.key"},
     {cacertfile, "priv/ssl/ca.crt"},
     {verify, verify_peer},
     {fail_if_no_peer_cert, false},  % Allow connections without client cert (for invite cert issuance)
     {depth, 1}
   ]},
   
   %% Event handling
   {cryptic_event_handlers, [cryptic_console_logger]},
   
   %% Debug settings
   {enable_debug, false}
 ]},
 
 {kernel, [
   {logger_level, info},
   {logger, [
     {handler, default, logger_std_h, #{
       config => #{
         file => "log/server.log",
         max_no_bytes => 10485760,  % 10 MB
         max_no_files => 5
       },
       formatter => {logger_formatter, #{
         single_line => false,
         template => [time," [",level,"] ",pid," ",mfa,":",line," - ",msg,"\n"]
       }}
     }}
   ]}
 ]}
].
