[
    %% Cryptic application configuration
    {cryptic, [
        %% Automatic Certificate Renewal Configuration
        {auto_cert_renewal_enabled, true},      % Enable automatic renewal (default: true)
        {cert_renewal_threshold, 0.5},          % Trigger renewal at 50% of cert lifetime remaining
        {cert_renewal_check_interval, 3600},    % Check every hour (3600 seconds)
        {cert_renewal_max_retries, 5},          % Max retry attempts before alerting user
        {cert_renewal_retry_interval, 3600},    % Base retry interval: 1 hour (seconds)

        %% CA Certificate Files (generated by myca)
        {ca_cert_file, "priv/ssl/ca.crt"},
        {ca_key_file, "priv/ssl/ca.key"},

        %% Server Certificate Files (for mTLS)
        {server_cert_file, "priv/ssl/server.crt"},
        {server_key_file, "priv/ssl/server.key"},

        %% Localhost-only MCP admin HTTP endpoint (plain TCP)
        {mcp_tcp_enabled, true},
        {mcp_tcp_port, 8081},

        %% Directory holding GPG bootstrap keys
        {bootstrap_dir, "priv/ca/bootstrap"},

        %% Database Configuration
        {ca_db_file, "data/ca/cryptic_ca.db"},
        {storage_backend, esqlite},

        %% Certificate Policy
        {cert_default_lifetime_days, 7},   % Default: 7 days
        {cert_max_lifetime_days, 30},      % Maximum: 30 days

        %% Audit Configuration
        {audit_enabled, true},
        {audit_retention_days, 90},

        %% CA Rate Limiting Configuration
        %% Format: {Operation, {MaxTokens, WindowSeconds}}
        {ca_rate_limits, #{
            %% Registration (per IP address)

            %% 100 attempts per hour per IP
            register_gpg => {100, 3600},

            %% CSR operations (per GPG fingerprint)

            %% 50 CSR requests per hour
            csr => {50, 3600},

            %% Status checks (per IP address)

            %% 200 status checks per hour per IP
            status => {200, 3600}
        }}
    ]},

    %% SASL configuration
    {sasl, [
        {sasl_error_logger, false}
    ]},

    %% Kernel configuration
    {kernel, [
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                level => info,
                formatter =>
                    {logger_formatter, #{
                        template => [time, " [", level, "] ", msg, "\n"]
                    }}
            }}
        ]}
    ]}
].
