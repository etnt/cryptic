[
 {cryptic_client, [
   %% Default server URLs
   {default_server_url, "http://localhost:8080"},
   {default_https_server_url, "https://localhost:8443"},
   
   %% SSL/TLS client configuration for mTLS
   {ssl_options, [
     {certfile, "priv/ssl/client.crt"},
     {keyfile, "priv/ssl/client.key"},
     {cacertfile, "priv/ssl/ca.crt"},
     {verify, verify_peer},
     {server_name_indication, disable}, % For self-signed certs
     {depth, 1}
   ]},
   
   %% Client polling configuration
   {poll_interval, 2},
   
   %% Event handling
   {cryptic_event_handlers, [cryptic_console_logger]},
   
   %% Chat storage
   {storage_db_path, "~/.cryptic/chat.db"},
   
   %% Debug settings
   {enable_debug, false}
 ]},
 
 {kernel, [
   {logger_level, info},
   {logger, [
     {handler, default, logger_std_h, #{
       config => #{
         file => "log/client.log",
         max_no_bytes => 10485760,  % 10 MB
         max_no_files => 5
       },
       formatter => {logger_formatter, #{
         single_line => false,
         template => [time," [",level,"] ",pid," ",mfa,":",line," - ",msg,"\n"]
       }}
     }}
   ]}
 ]}
].
