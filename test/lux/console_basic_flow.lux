[doc Double Ratchet Console Test - Basic Message Flow]

[global alice_passphrase=qwe123]


[shell server]
    # Start the Cryptic server
    !env CRYPTIC_DEBUG=true ../../scripts/start-server.sh
    ?Cryptic WebSocket server with mTLS started on port 8443
    ?\(server@localhost\)[0-9]+\>



[shell alice]
    # Start Alice's console
    !env CRYPTIC_DEBUG=true ../../scripts/cryptic_console -u alice
    ?Enter passphrase

[shell alice-log]
    !tail -f ./logs/client-alice.log
    ?WebSocket connection established for alice

[shell alice]
    !$alice_passphrase
    ?cryptic>



[shell alice]
    # Quit Alice
    !quit
    ?Goodbye!


[cleanup]