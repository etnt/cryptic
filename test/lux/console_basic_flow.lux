[doc Double Ratchet Console Test - Basic Message Flow]

[config shell_cmd=/bin/bash]
[config shell_prompt_cmd=bind 'set enable-bracketed-paste off'; unset PROMPT_COMMAND; export PS1="SH-PROMPT:"]
[config shell_wrapper=../../_build/default/lib/lux/priv/bin/runpty]
#[config shell_prompt_regexp=^SH-PROMPT:]

[global PORT=9997]
[global alice_passphrase=qwe123]
[global bob_passphrase=qwe123]

[macro log message]
    [progress \n$message\n]
[endmacro]

[macro ok]
    [my tmp=$LUX_FAIL_PATTERN]
    ?SH-PROMPT
    -==[1-9][0-9]*==
    !echo ==$$?==
    ?==0==
    ?SH-PROMPT
    -$tmp
[endmacro]

[shell prepare]
    !rm -f $HOME/.cryptic/*/localhost_${PORT}/keys.encrypted
    [invoke ok]
    !rm -f $HOME/.cryptic/*/localhost_${PORT}/sessions/*
    [invoke ok]

[shell server]
    [invoke log "Start the Cryptic server..."]
    !env CRYPTIC_DEBUG=true ../../scripts/start-server.sh localhost ${PORT}
    ?\(server@localhost\)[0-9]+\>

[shell server-log]
    !tail -f ./logs/server.log

[shell alice]
    [invoke log "Start Alice's console..."]
    !env CRYPTIC_DEBUG=true ../../scripts/cryptic_console -u alice -p ${PORT}
    ?Enter passphrase

[shell alice-log]
    !tail -f ./logs/client-alice.log
    ?WebSocket connection established for alice

[shell alice]
    !$alice_passphrase
    ?cryptic>

[shell server-log]
    ?.*cryptic_ws_handler.*Processing validated message from: alice , type: upload_identity_keys
    ?.*cryptic_ws_handler.*Processing validated message from: alice , type: upload_prekey_bundle

[shell alice]
    [invoke log "Alice tries to send a message to Bob, who does not exist yet"]
    !send bob Hi Bob, this is Alice!
    ?User 'bob' not found - message could not be delivered
    ?cryptic>

[shell bob]
    [invoke log "Start Bob's console..."]
    !env CRYPTIC_DEBUG=true ../../scripts/cryptic_console -u bob -p ${PORT}
    ?Enter passphrase

[shell bob-log]
    !tail -f ./logs/client-bob.log
    ?WebSocket connection established for bob

[shell bob]
    !$bob_passphrase
    ?cryptic>

[shell server-log]
    ?.*cryptic_ws_handler.*Processing validated message from: bob , type: upload_identity_keys
    ?.*cryptic_ws_handler.*Processing validated message from: bob , type: upload_prekey_bundle

[shell alice]
    [invoke log "Alice sends a message to Bob"]
    !send bob Hi Bob, this is Alice!
    ?<You => bob>.*Hi Bob, this is Alice!
    ?cryptic>

[shell bob]
    [invoke log "Bob receives Alice's message"]
    ?<alice>.*Hi Bob, this is Alice!

[shell alice]
    [invoke log "Alice sends another message to Bob"]
    !send bob How are you?
    ?<You => bob>.*How are you?
    ?cryptic>

[shell bob]
    [invoke log "Bob receives Alice's second message"]
    ?<alice>.*How are you?
    ?cryptic>
    [invoke log "Bob replies to Alice"]
    !send alice Hi Alice, I am fine, thanks!
    ?<You => alice>.*Hi Alice, I am fine, thanks!
    ?cryptic>

[shell alice]
    [invoke log "Alice receives Bob's reply"]
    ?<bob>.*Hi Alice, I am fine, thanks!
    ?cryptic>

[shell alice]
    [invoke log "Quit Alice"]
    ~$_CTRL_C
    ~$_CTRL_C
    [invoke ok]

[shell server-log]
    ?.*User alice disconnected and removed from connection table

[shell bob]
    [invoke log "Quit Bob"]
    ~$_CTRL_C
    ~$_CTRL_C
    [invoke ok]

[shell server-log]
    ?.*User bob disconnected and removed from connection table

[shell server]
    !init:stop().
    [invoke ok]

[cleanup]