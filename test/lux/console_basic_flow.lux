[doc Double Ratchet Console Test - Basic Message Flow]

#[config shell_cmd=/bin/bash]
#[config shell_prompt_cmd=bind 'set enable-bracketed-paste off'; unset PROMPT_COMMAND; export PS1="SH-PROMPT:"]
#[config shell_prompt_regexp=^SH-PROMPT:]

[global alice_passphrase=qwe123]
[global bob_passphrase=qwe123]

[macro log message]
    [progress \n$message\n]
[endmacro]


[shell server]
    [invoke log "Start the Cryptic server..."]
    !env CRYPTIC_DEBUG=true ../../scripts/start-server.sh
    ?Cryptic WebSocket server with mTLS started on port 8443
    ?\(server@localhost\)[0-9]+\>

[shell server-log]
    !tail -f ./logs/server.log

[shell alice]
    [invoke log "Start Alice's console..."]
    !env CRYPTIC_DEBUG=true ../../scripts/cryptic_console -u alice
    ?Enter passphrase

[shell alice-log]
    !tail -f ./logs/client-alice.log
    ?WebSocket connection established for alice

[shell alice]
    !$alice_passphrase
    ?cryptic>

[shell server-log]
    ?.*cryptic_ws_handler.*Processing validated message from: alice , type: upload_identity_keys
    ?.*cryptic_ws_handler.*Processing validated message from: alice , type: upload_prekey_bundle

[shell alice]
    [invoke log "Alice tries to send a message to Bob, who does not exist yet"]
    !send bob Hi Bob, this is Alice!
    ?User 'bob' not found - message could not be delivered
    ?cryptic>

[shell bob]
    [invoke log "Start Bob's console..."]
    !env CRYPTIC_DEBUG=true ../../scripts/cryptic_console -u bob
    ?Enter passphrase

[shell bob-log]
    !tail -f ./logs/client-bob.log
    ?WebSocket connection established for bob

[shell bob]
    !$bob_passphrase
    ?cryptic>

[shell server-log]
    ?.*cryptic_ws_handler.*Processing validated message from: bob , type: upload_identity_keys
    ?.*cryptic_ws_handler.*Processing validated message from: bob , type: upload_prekey_bundle


[shell alice]
    [invoke log "Quit Alice"]
    !quit
    ?Goodbye!

[shell server-log]
    ?.*User alice disconnected and removed from connection table

[shell bob]
    [invoke log "Quit Bob"]
    !quit
    ?Goodbye!

[shell server-log]
    ?.*User bob disconnected and removed from connection table

[cleanup]